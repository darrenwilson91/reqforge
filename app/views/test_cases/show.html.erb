<% content_for(:page_title, "#{@test_case.uid} — #{@test_case.title}") %>

<div class="space-y-6">
  <%= breadcrumbs(
    ["Projects", projects_path],
    [@project.name, project_path(@project)],
    ["Test Cases", project_test_cases_path(@project)],
    @test_case.uid
  ) %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-3 mb-2">
        <span class="rf-uid text-base"><%= @test_case.uid %></span>
        <span class="<%= test_status_badge_class(@test_case) %>"><%= @test_case.status.humanize %></span>
        <span class="<%= test_type_badge_class(@test_case) %>"><%= @test_case.test_type.humanize %></span>
        <span class="<%= test_priority_badge_class(@test_case) %>"><%= @test_case.priority.humanize %></span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= @test_case.title %></h1>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <%= link_to edit_project_test_case_path(@project, @test_case), class: "rf-btn-secondary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
        </svg>
        Edit
      <% end %>
      <%= button_to project_test_case_path(@project, @test_case), method: :delete,
        class: "rf-btn-danger",
        form: { data: { turbo_confirm: "Are you sure you want to delete this test case?" } } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Metadata row -->
  <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
    <% if @test_case.requirement %>
      <div class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
        </svg>
        Verifies:
        <%= link_to project_requirement_path(@project, @test_case.requirement), class: "rf-uid text-xs hover:text-brand-accent transition-colors" do %>
          <%= @test_case.requirement.uid %>
        <% end %>
        <span class="text-slate-400 dark:text-slate-500">(<%= @test_case.requirement.title.truncate(40) %>)</span>
      </div>
    <% end %>
    <div class="flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
      </svg>
      <%= @test_case.created_by.full_name %>
    </div>
    <div class="flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
      </svg>
      Created <%= time_ago_in_words(@test_case.created_at) %> ago
    </div>
    <div class="flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      <%= pluralize(@test_case.versions.count, "revision") %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main content (2/3) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Description -->
      <% if @test_case.description.present? %>
        <div class="rf-card p-5">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Description</h2>
          <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed"><%= simple_format(@test_case.description) %></div>
        </div>
      <% end %>

      <!-- Preconditions -->
      <% if @test_case.preconditions.present? %>
        <div class="rf-card p-5">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Preconditions</h2>
          <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed bg-slate-50 dark:bg-slate-800/50 rounded-lg p-4 border border-slate-200 dark:border-slate-700">
            <%= simple_format(@test_case.preconditions) %>
          </div>
        </div>
      <% end %>

      <!-- Steps -->
      <% if @test_case.steps.present? %>
        <div class="rf-card p-5">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Test Steps</h2>
          <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-mono bg-slate-50 dark:bg-slate-800/50 rounded-lg p-4 border border-slate-200 dark:border-slate-700 whitespace-pre-wrap">
            <%= @test_case.steps %>
          </div>
        </div>
      <% end %>

      <!-- Expected Result -->
      <% if @test_case.expected_result.present? %>
        <div class="rf-card p-5">
          <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Expected Result</h2>
          <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed bg-emerald-50 dark:bg-emerald-900/20 rounded-lg p-4 border border-emerald-200 dark:border-emerald-800">
            <%= simple_format(@test_case.expected_result) %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar (1/3) -->
    <div class="space-y-6">
      <!-- Attributes -->
      <div class="rf-card p-5">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-4">Attributes</h2>
        <dl class="space-y-3">
          <div class="flex items-center justify-between">
            <dt class="text-sm text-slate-500 dark:text-slate-400">Type</dt>
            <dd><span class="<%= test_type_badge_class(@test_case) %>"><%= @test_case.test_type.humanize %></span></dd>
          </div>
          <div class="border-t border-slate-100 dark:border-slate-700"></div>
          <div class="flex items-center justify-between">
            <dt class="text-sm text-slate-500 dark:text-slate-400">Status</dt>
            <dd class="flex items-center gap-1.5">
              <%= test_status_icon(@test_case) %>
              <span class="<%= test_status_badge_class(@test_case) %>"><%= @test_case.status.humanize %></span>
            </dd>
          </div>
          <div class="border-t border-slate-100 dark:border-slate-700"></div>
          <div class="flex items-center justify-between">
            <dt class="text-sm text-slate-500 dark:text-slate-400">Priority</dt>
            <dd><span class="<%= test_priority_badge_class(@test_case) %>"><%= @test_case.priority.humanize %></span></dd>
          </div>
          <% if @test_case.requirement %>
            <div class="border-t border-slate-100 dark:border-slate-700"></div>
            <div>
              <dt class="text-sm text-slate-500 dark:text-slate-400 mb-1">Linked Requirement</dt>
              <dd>
                <%= link_to project_requirement_path(@project, @test_case.requirement), class: "flex items-center gap-2 p-2 -mx-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" do %>
                  <span class="rf-uid text-xs"><%= @test_case.requirement.uid %></span>
                  <span class="text-sm text-slate-700 dark:text-slate-300 truncate"><%= @test_case.requirement.title %></span>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- Version History -->
      <div class="rf-card p-5">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-3">Version History</h2>
        <% if @test_case.versions.any? %>
          <div class="space-y-2">
            <% @test_case.versions.reverse.first(10).each_with_index do |version, i| %>
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-medium text-[10px]">
                  <%= @test_case.versions.count - i %>
                </span>
                <span class="capitalize"><%= version.event %></span>
                <span class="text-slate-400 dark:text-slate-500">&middot;</span>
                <span><%= time_ago_in_words(version.created_at) %> ago</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-slate-400 dark:text-slate-500">No version history available.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
