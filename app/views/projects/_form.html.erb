<%= form_with(model: project, class: "space-y-6") do |f| %>
  <% if project.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <div class="flex items-center gap-2 text-sm font-medium text-red-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
        <%= pluralize(project.errors.count, "error") %> prevented this project from being saved:
      </div>
      <ul class="mt-2 ml-7 list-disc text-sm text-red-700 space-y-1">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Project Name %>
    <div>
      <%= f.label :name, class: "rf-label" %>
      <%= f.text_field :name, class: "rf-input", placeholder: "e.g. Vehicle Control Unit" %>
    </div>

    <%# Prefix %>
    <div>
      <%= f.label :prefix, class: "rf-label" %>
      <%= f.text_field :prefix, class: "rf-input font-mono uppercase", placeholder: "e.g. VCU", maxlength: 10,
          disabled: project.persisted? && project.requirements.exists? %>
      <p class="mt-1 text-xs text-slate-400">
        Used for requirement UIDs (e.g. <%= project.prefix.presence || "VCU" %>-001). Uppercase letters, digits, hyphens only.
        <% if project.persisted? && project.requirements.exists? %>
          <span class="text-amber-600 font-medium">Locked — project has requirements.</span>
        <% end %>
      </p>
    </div>
  </div>

  <%# Description %>
  <div>
    <%= f.label :description, class: "rf-label" %>
    <%= f.text_area :description, class: "rf-input min-h-[100px]", placeholder: "Describe the project scope, objectives, and key stakeholders...", rows: 4 %>
  </div>

  <%# Status (only for edit) %>
  <% if project.persisted? %>
    <div class="max-w-xs">
      <%= f.label :status, class: "rf-label" %>
      <%= f.select :status, Project.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "rf-input" %>
    </div>
  <% end %>

  <%# Compliance Template (only for new projects) %>
  <% if project.new_record? %>
    <% templates = ComplianceTemplate.active %>
    <% if templates.any? %>
      <div class="border-t border-slate-200 pt-6">
        <%
          template_data = {}
          templates.each do |t|
            data = t.template_data.deep_symbolize_keys
            template_data[t.id.to_s] = {
              description: t.description,
              phases: (data[:modules] || []).map { |m| { name: m[:name] } },
              attributes: (data[:attribute_schema] || []).map { |a| { name: a[:name], type: a[:type] } }
            }
          end
        %>
        <div data-controller="template-select"
             data-template-select-templates-value="<%= template_data.to_json %>">
          <div class="mb-4">
            <h3 class="text-sm font-semibold text-slate-700">Compliance Template</h3>
            <p class="text-xs text-slate-400 mt-0.5">Optionally start from a compliance standard template to pre-populate modules, sections, and custom attributes.</p>
          </div>

          <div class="max-w-md">
            <label for="compliance_template_id" class="rf-label">Template</label>
            <select name="compliance_template_id" id="compliance_template_id"
                    class="rf-input"
                    data-action="change->template-select#update">
              <option value="">None — blank project</option>
              <% templates.each do |t| %>
                <option value="<%= t.id %>"><%= t.name %> (<%= t.standard.gsub("_", " ").upcase %>)</option>
              <% end %>
            </select>
          </div>

          <%# Template details panel %>
          <div data-template-select-target="details" class="hidden mt-4 rounded-lg border border-brand-accent/20 bg-brand-accent-subtle p-4 space-y-4">
            <p data-template-select-target="description" class="text-sm text-slate-600"></p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <%# Phases %>
              <div>
                <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Modules Created</h4>
                <div data-template-select-target="phases" class="space-y-0"></div>
              </div>

              <%# Custom attributes %>
              <div>
                <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Custom Attributes Added</h4>
                <div data-template-select-target="attributes" class="flex flex-wrap gap-1.5"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Custom Attribute Schema %>
  <div class="border-t border-slate-200 pt-6">
    <div data-controller="attribute-schema"
         data-attribute-schema-attributes-value="<%= (project.attribute_schema.presence || []).to_json %>">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-semibold text-slate-700">Custom Attributes</h3>
          <p class="text-xs text-slate-400 mt-0.5">Define additional fields that requirements in this project will have.</p>
        </div>
        <button type="button"
                data-action="click->attribute-schema#addAttribute"
                class="rf-btn-secondary text-xs flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Add Attribute
        </button>
      </div>
      <div data-attribute-schema-target="container" class="space-y-3"></div>
      <%= f.hidden_field :attribute_schema, value: (project.attribute_schema.presence || []).to_json, data: { attribute_schema_target: "hiddenField" } %>
    </div>
  </div>

  <%# Actions %>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit project.persisted? ? "Update Project" : "Create Project", class: "rf-btn-primary cursor-pointer" %>
    <%= link_to "Cancel", project.persisted? ? project_path(project) : projects_path, class: "rf-btn-secondary" %>
  </div>
<% end %>
