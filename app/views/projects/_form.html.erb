<%= form_with(model: project, class: "space-y-6") do |f| %>
  <% if project.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <div class="flex items-center gap-2 text-sm font-medium text-red-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
        </svg>
        <%= pluralize(project.errors.count, "error") %> prevented this project from being saved:
      </div>
      <ul class="mt-2 ml-7 list-disc text-sm text-red-700 space-y-1">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Project Name %>
    <div>
      <%= f.label :name, class: "rf-label" %>
      <%= f.text_field :name, class: "rf-input", placeholder: "e.g. Vehicle Control Unit" %>
    </div>

    <%# Prefix %>
    <div>
      <%= f.label :prefix, class: "rf-label" %>
      <%= f.text_field :prefix, class: "rf-input font-mono uppercase", placeholder: "e.g. VCU", maxlength: 10,
          disabled: project.persisted? && project.requirements.exists? %>
      <p class="mt-1 text-xs text-slate-400">
        Used for requirement UIDs (e.g. <%= project.prefix.presence || "VCU" %>-001). Uppercase letters, digits, hyphens only.
        <% if project.persisted? && project.requirements.exists? %>
          <span class="text-amber-600 font-medium">Locked — project has requirements.</span>
        <% end %>
      </p>
    </div>
  </div>

  <%# Description %>
  <div>
    <%= f.label :description, class: "rf-label" %>
    <%= f.text_area :description, class: "rf-input min-h-[100px]", placeholder: "Describe the project scope, objectives, and key stakeholders...", rows: 4 %>
  </div>

  <%# Status (only for edit) %>
  <% if project.persisted? %>
    <div class="max-w-xs">
      <%= f.label :status, class: "rf-label" %>
      <%= f.select :status, Project.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "rf-input" %>
    </div>
  <% end %>

  <%# Actions %>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit project.persisted? ? "Update Project" : "Create Project", class: "rf-btn-primary cursor-pointer" %>
    <%= link_to "Cancel", project.persisted? ? project_path(project) : projects_path, class: "rf-btn-secondary" %>
  </div>
<% end %>
