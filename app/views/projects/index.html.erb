<% content_for(:page_title, "Projects") %>

<div class="space-y-6">
  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Projects</h1>
      <p class="mt-1 text-sm text-slate-500">Manage your requirements engineering projects.</p>
    </div>
    <%= link_to new_project_path, class: "rf-btn-primary" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      New Project
    <% end %>
  </div>

  <% if @projects.any? %>
    <%# Project Cards Grid %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <% @projects.each do |project| %>
        <%= link_to project_path(project), class: "rf-card group hover:border-brand-accent/40 hover:shadow-md transition-all duration-200 block" do %>
          <div class="p-5">
            <%# Header row: prefix badge + status %>
            <div class="flex items-center justify-between mb-3">
              <span class="rf-uid"><%= project.prefix %></span>
              <span class="<%= project_status_badge_class(project) %>"><%= project.status.humanize %></span>
            </div>

            <%# Title %>
            <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand-accent-dark transition-colors truncate"><%= project.name %></h3>

            <%# Description %>
            <% if project.description.present? %>
              <p class="mt-1.5 text-sm text-slate-500 line-clamp-2"><%= project.description %></p>
            <% end %>

            <%# Stats row %>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-4 text-xs text-slate-400">
              <div class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                </svg>
                <%= pluralize(project.requirement_modules.size, "module") %>
              </div>
              <div class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                </svg>
                <%= pluralize(project.requirements.size, "requirement") %>
              </div>
              <div class="ml-auto text-slate-400">
                Updated <%= time_ago_in_words(project.updated_at) %> ago
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="rf-card">
      <div class="rf-empty-state py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
        </svg>
        <p class="rf-empty-state-title">No projects yet</p>
        <p class="rf-empty-state-description">Create your first project to start managing requirements.</p>
        <div class="mt-5">
          <%= link_to new_project_path, class: "rf-btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            New Project
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
