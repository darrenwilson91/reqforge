<% content_for(:page_title, @project.name) %>

<div class="space-y-6">
  <%# Breadcrumb %>
  <nav class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "Projects", projects_path, class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <span class="text-slate-900 font-medium"><%= @project.name %></span>
  </nav>

  <%# Project Header %>
  <div class="rf-card-padded">
    <div class="flex items-start justify-between">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-3 mb-2">
          <span class="rf-uid text-sm"><%= @project.prefix %></span>
          <span class="<%= project_status_badge_class(@project) %>"><%= @project.status.humanize %></span>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 truncate"><%= @project.name %></h1>
        <% if @project.description.present? %>
          <p class="mt-2 text-sm text-slate-500 max-w-2xl"><%= @project.description %></p>
        <% end %>
      </div>

      <div class="flex items-center gap-2 shrink-0 ml-4">
        <%= link_to edit_project_path(@project), class: "rf-btn-secondary" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
          </svg>
          Edit
        <% end %>
        <%= button_to project_path(@project), method: :delete, class: "rf-btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this project? This action cannot be undone." } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          Delete
        <% end %>
      </div>
    </div>
  </div>

  <%# Stats Row %>
  <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Modules</div>
      <div class="mt-1 text-xl font-bold text-slate-900"><%= @modules.size %></div>
    </div>
    <%= link_to project_requirements_path(@project), class: "rf-card p-4 hover:border-brand-accent/40 transition-colors block" do %>
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Requirements</div>
      <div class="mt-1 text-xl font-bold text-slate-900"><%= @project.requirements.count %></div>
    <% end %>
    <%= link_to project_traceability_matrix_path(@project), class: "rf-card p-4 hover:border-brand-accent/40 transition-colors block" do %>
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Traceability</div>
      <div class="mt-1 text-xl font-bold text-slate-900"><%= TraceabilityMatrix.new(@project).links.count %></div>
      <div class="text-xs text-slate-400 mt-0.5">links</div>
    <% end %>
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Created</div>
      <div class="mt-1 text-sm font-medium text-slate-900"><%= @project.created_at.strftime("%b %-d, %Y") %></div>
    </div>
  </div>

  <%# Custom Attributes %>
  <% if @project.attribute_schema.is_a?(Array) && @project.attribute_schema.any? %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Custom Attributes</h2>
      </div>
      <div class="p-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <% @project.attribute_schema.each do |attr| %>
            <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg border border-slate-100">
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-slate-700 truncate"><%= attr["name"] %></div>
                <div class="text-xs text-slate-400">
                  <%= attr["attr_type"]&.humanize || "Text" %>
                  <% if attr["required"] %>
                    <span class="text-amber-600 font-medium">&middot; Required</span>
                  <% end %>
                  <% if attr["attr_type"] == "enum" && attr["options"].present? %>
                    <span class="text-slate-400">&middot; <%= Array(attr["options"]).join(", ") %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Modules Tree %>
  <div class="rf-card">
    <div class="p-5 border-b border-slate-100">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-900">Modules & Sections</h2>
      </div>
    </div>

    <% if @modules.any? %>
      <div class="divide-y divide-slate-100">
        <% @modules.each do |mod| %>
          <div class="p-4 hover:bg-slate-50/50 transition-colors">
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-50 text-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-slate-900"><%= mod.name %></div>
                <% if mod.description.present? %>
                  <div class="text-xs text-slate-500"><%= mod.description %></div>
                <% end %>
              </div>
              <div class="ml-auto text-xs text-slate-400">
                <%= pluralize(mod.sections.size, "section") %>
              </div>
            </div>

            <% if mod.sections.any? %>
              <div class="mt-2 ml-11 space-y-1">
                <% mod.sections.select { |s| s.parent_section_id.nil? }.each do |section| %>
                  <div class="flex items-center gap-2 text-sm text-slate-600 py-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                    </svg>
                    <%= section.name %>
                    <span class="text-xs text-slate-400"><%= pluralize(section.requirements.size, "req") %></span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rf-empty-state py-12">
        <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
        </svg>
        <p class="rf-empty-state-title">No modules yet</p>
        <p class="rf-empty-state-description">Modules organize your requirements into logical groups. They will be available once you start adding requirements.</p>
      </div>
    <% end %>
  </div>
</div>
