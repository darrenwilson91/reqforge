<% content_for(:page_title, "My Work") %>

<div class="space-y-6">
  <%# Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <%= breadcrumbs("My Work") %>
      <h1 class="mt-2 text-2xl font-bold text-slate-900 dark:text-slate-100">My Work</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Your requirements, change sets, reviews, and test cases across all projects.</p>
    </div>
  </div>

  <%# Summary Cards %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="rf-card p-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= @total_requirements %></div>
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">My Requirements</div>
        </div>
      </div>
    </div>

    <div class="rf-card p-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-900/30 dark:text-violet-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= @total_change_sets %></div>
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Active Change Sets</div>
        </div>
      </div>
    </div>

    <div class="rf-card p-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= @my_review_count %></div>
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Pending Reviews</div>
        </div>
      </div>
    </div>

    <div class="rf-card p-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= @total_test_cases %></div>
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">My Test Cases</div>
        </div>
      </div>
    </div>
  </div>

  <%# Needs Your Attention — Pending Reviews %>
  <% if @my_review_change_sets.any? %>
    <div class="rf-card">
      <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Needs Your Review</h2>
          <span class="rf-badge bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"><%= @my_review_count %></span>
        </div>
      </div>
      <div class="divide-y divide-slate-100 dark:divide-slate-700">
        <% @my_review_change_sets.each do |approval| %>
          <% cs = approval.change_set %>
          <%= link_to project_change_set_path(cs.project, cs), class: "flex items-center justify-between px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" do %>
            <div class="flex items-center gap-3 min-w-0">
              <div class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-50 text-violet-600 dark:bg-violet-900/30 dark:text-violet-400 text-xs font-medium shrink-0">
                <%= cs.created_by.first_name[0] %><%= cs.created_by.last_name[0] %>
              </div>
              <div class="min-w-0">
                <div class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= cs.title %></div>
                <div class="text-xs text-slate-500 dark:text-slate-400">
                  <%= cs.project.name %> &middot; by <%= cs.created_by.full_name %> &middot; <%= time_ago_in_words(cs.created_at) %> ago
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-3">
              <% changes = cs.change_set_changes %>
              <% if changes.any? %>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                  <%= changes.where(change_type: :created).count %>+ <%= changes.where(change_type: :modified).count %>~ <%= changes.where(change_type: :deleted).count %>&minus;
                </span>
              <% end %>
              <span class="<%= change_set_status_badge_class(cs) %> text-xs"><%= cs.status.humanize %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Pending Formal Reviews %>
  <% if @my_formal_reviews.any? %>
    <div class="rf-card">
      <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
          </svg>
          <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Active Formal Reviews</h2>
          <span class="rf-badge bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300"><%= @my_formal_reviews.size %></span>
        </div>
      </div>
      <div class="divide-y divide-slate-100 dark:divide-slate-700">
        <% @my_formal_reviews.each do |participant| %>
          <% review = participant.review %>
          <%= link_to project_review_path(review.project, review), class: "flex items-center justify-between px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" do %>
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= review.title %></div>
              <div class="text-xs text-slate-500 dark:text-slate-400">
                <%= review.project.name %> &middot; <span class="capitalize"><%= participant.role %></span> &middot; <%= review.review_items.size %> items
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-3">
              <% decided = review.review_items.select(&:decided?).size %>
              <% total = review.review_items.size %>
              <span class="text-xs text-slate-500 dark:text-slate-400"><%= decided %>/<%= total %></span>
              <span class="<%= review_status_badge_class(review) %> text-xs"><%= review.status.humanize %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# My Requirements %>
  <div class="rf-card">
    <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2">
          <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">My Requirements</h2>
          <span class="rf-badge bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300"><%= @my_requirements_count %></span>
        </div>
        <%# Status filter %>
        <div class="flex items-center gap-1.5 flex-wrap">
          <%= link_to "All", my_work_path, class: "text-xs px-2.5 py-1 rounded-full transition-colors #{@requirements_status_filter.blank? ? 'bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-700'}" %>
          <% Requirement.statuses.each_key do |status| %>
            <% count = @my_requirements_status_counts[status] || 0 %>
            <% next if count.zero? %>
            <%= link_to "#{status.humanize} (#{count})", my_work_path(req_status: status), class: "text-xs px-2.5 py-1 rounded-full transition-colors #{@requirements_status_filter == status ? 'bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-700'}" %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @my_requirements.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 dark:divide-slate-700">
          <thead>
            <tr class="text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="px-5 py-3">UID</th>
              <th class="px-5 py-3">Title</th>
              <th class="px-5 py-3 hidden sm:table-cell">Project</th>
              <th class="px-5 py-3 hidden md:table-cell">Type</th>
              <th class="px-5 py-3">Status</th>
              <th class="px-5 py-3 hidden lg:table-cell">Updated</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50 dark:divide-slate-800">
            <% @my_requirements.each do |req| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                <td class="px-5 py-3">
                  <%= link_to req.uid, project_requirement_path(req.project, req), class: "rf-uid text-xs" %>
                </td>
                <td class="px-5 py-3">
                  <%= link_to req.title, project_requirement_path(req.project, req), class: "text-sm font-medium text-slate-900 dark:text-slate-100 hover:text-brand-accent-dark transition-colors" %>
                </td>
                <td class="px-5 py-3 hidden sm:table-cell">
                  <span class="text-xs text-slate-500 dark:text-slate-400"><%= req.project.name %></span>
                </td>
                <td class="px-5 py-3 hidden md:table-cell">
                  <span class="<%= requirement_type_badge_class(req) %> text-xs"><%= req.requirement_type.humanize %></span>
                </td>
                <td class="px-5 py-3">
                  <span class="<%= requirement_status_badge_class(req) %> text-xs"><%= req.status.humanize %></span>
                </td>
                <td class="px-5 py-3 hidden lg:table-cell">
                  <span class="text-xs text-slate-500 dark:text-slate-400"><%= time_ago_in_words(req.updated_at) %> ago</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rf-empty-state py-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          <% if @requirements_status_filter.present? %>
            No requirements with status "<%= @requirements_status_filter.humanize %>" found.
          <% else %>
            You haven't authored any requirements yet.
          <% end %>
        </p>
      </div>
    <% end %>
  </div>

  <%# My Change Sets %>
  <div class="rf-card">
    <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
      <div class="flex items-center gap-2">
        <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">My Change Sets</h2>
        <span class="rf-badge bg-violet-50 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300"><%= @my_created_count %></span>
      </div>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Active change sets you created (excludes merged and closed).</p>
    </div>

    <% if @my_created_change_sets.any? %>
      <div class="divide-y divide-slate-100 dark:divide-slate-700">
        <% @my_created_change_sets.each do |cs| %>
          <%= link_to project_change_set_path(cs.project, cs), class: "flex items-center justify-between px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" do %>
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= cs.title %></div>
              <div class="text-xs text-slate-500 dark:text-slate-400">
                <%= cs.project.name %> &middot; <%= time_ago_in_words(cs.updated_at) %> ago
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-3">
              <% changes = cs.change_set_changes %>
              <% if changes.any? %>
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                  <span class="text-emerald-600 dark:text-emerald-400">+<%= changes.where(change_type: :created).count %></span>
                  <span class="text-amber-600 dark:text-amber-400">~<%= changes.where(change_type: :modified).count %></span>
                  <span class="text-red-600 dark:text-red-400">&minus;<%= changes.where(change_type: :deleted).count %></span>
                </span>
              <% end %>
              <% approvals = cs.change_set_approvals %>
              <% if approvals.any? %>
                <span class="text-xs text-slate-500 dark:text-slate-400"><%= approvals.where(status: :approved).count %>/<%= approvals.count %></span>
              <% end %>
              <span class="<%= change_set_status_badge_class(cs) %> text-xs"><%= cs.status.humanize %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rf-empty-state py-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" />
        </svg>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">No active change sets. Create one to start proposing changes.</p>
      </div>
    <% end %>
  </div>

  <%# My Test Cases %>
  <div class="rf-card">
    <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2">
          <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">My Test Cases</h2>
          <span class="rf-badge bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300"><%= @my_test_cases_count %></span>
        </div>
        <% if @my_test_cases_status_counts.any? %>
          <div class="flex items-center gap-2 flex-wrap">
            <% { "passed" => "emerald", "failed" => "red", "blocked" => "amber", "not_run" => "slate", "ready" => "blue", "draft" => "slate" }.each do |status, color| %>
              <% count = @my_test_cases_status_counts[status] || 0 %>
              <% next if count.zero? %>
              <span class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
                <span class="w-2 h-2 rounded-full bg-<%= color %>-500"></span>
                <%= status.humanize %> (<%= count %>)
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @my_test_cases.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 dark:divide-slate-700">
          <thead>
            <tr class="text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="px-5 py-3">UID</th>
              <th class="px-5 py-3">Title</th>
              <th class="px-5 py-3 hidden sm:table-cell">Project</th>
              <th class="px-5 py-3 hidden md:table-cell">Requirement</th>
              <th class="px-5 py-3">Status</th>
              <th class="px-5 py-3 hidden lg:table-cell">Type</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50 dark:divide-slate-800">
            <% @my_test_cases.each do |tc| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                <td class="px-5 py-3">
                  <%= link_to tc.uid, project_test_case_path(tc.project, tc), class: "rf-uid text-xs" %>
                </td>
                <td class="px-5 py-3">
                  <%= link_to tc.title, project_test_case_path(tc.project, tc), class: "text-sm font-medium text-slate-900 dark:text-slate-100 hover:text-brand-accent-dark transition-colors" %>
                </td>
                <td class="px-5 py-3 hidden sm:table-cell">
                  <span class="text-xs text-slate-500 dark:text-slate-400"><%= tc.project.name %></span>
                </td>
                <td class="px-5 py-3 hidden md:table-cell">
                  <% if tc.requirement %>
                    <%= link_to tc.requirement.uid, project_requirement_path(tc.project, tc.requirement), class: "rf-uid text-xs" %>
                  <% else %>
                    <span class="text-xs text-slate-400 dark:text-slate-600">&mdash;</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <span class="<%= test_status_badge_class(tc) %> text-xs"><%= tc.status.humanize %></span>
                </td>
                <td class="px-5 py-3 hidden lg:table-cell">
                  <span class="<%= test_type_badge_class(tc) %> text-xs"><%= tc.test_type.humanize %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="rf-empty-state py-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">You haven't created any test cases yet.</p>
      </div>
    <% end %>
  </div>
</div>
