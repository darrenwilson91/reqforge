<div class="rf-card-padded">
  <h3 class="text-lg font-semibold text-slate-900 mb-6">Edit your profile</h3>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :first_name, class: "rf-label" %>
          <%= f.text_field :first_name, autocomplete: "given-name", class: "rf-input" %>
        </div>
        <div>
          <%= f.label :last_name, class: "rf-label" %>
          <%= f.text_field :last_name, autocomplete: "family-name", class: "rf-input" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "rf-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "rf-input" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="rounded-lg bg-amber-50 border border-amber-200 p-3">
          <p class="text-sm text-amber-800">Waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong></p>
        </div>
      <% end %>

      <hr class="border-slate-200">

      <p class="text-xs text-slate-500">Leave password fields blank if you don't want to change it.</p>

      <div>
        <%= f.label :password, "New password", class: "rf-label" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-slate-400 mb-1"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            placeholder: "New password (optional)", class: "rf-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "rf-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            placeholder: "Confirm new password", class: "rf-input" %>
      </div>

      <hr class="border-slate-200">

      <div>
        <%= f.label :current_password, class: "rf-label" %>
        <p class="text-xs text-slate-400 mb-1">We need your current password to confirm changes</p>
        <%= f.password_field :current_password, autocomplete: "current-password",
            placeholder: "Enter current password", class: "rf-input" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Update profile", class: "rf-btn-primary w-full justify-center" %>
      </div>
    </div>
  <% end %>

  <hr class="my-6 border-slate-200">

  <div class="text-center">
    <p class="text-sm text-slate-500 mb-3">Want to delete your account?</p>
    <%= button_to "Delete my account", registration_path(resource_name),
        method: :delete,
        class: "rf-btn-danger",
        data: { turbo_confirm: "Are you sure? This action cannot be undone." } %>
  </div>
</div>
