<div class="rf-card-padded">
  <h3 class="text-lg font-semibold text-slate-900 text-center mb-6">Create your account</h3>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :first_name, class: "rf-label" %>
          <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name",
              placeholder: "Jane", class: "rf-input" %>
        </div>
        <div>
          <%= f.label :last_name, class: "rf-label" %>
          <%= f.text_field :last_name, autocomplete: "family-name",
              placeholder: "Smith", class: "rf-input" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "rf-label" %>
        <%= f.email_field :email, autocomplete: "email",
            placeholder: "you@example.com", class: "rf-input" %>
      </div>

      <div>
        <%= f.label :password, class: "rf-label" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-slate-400 mb-1"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            placeholder: "Create a password", class: "rf-input" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "rf-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            placeholder: "Confirm your password", class: "rf-input" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Create account", class: "rf-btn-primary w-full justify-center" %>
      </div>
    </div>
  <% end %>
</div>

<%= render "devise/shared/links" %>
