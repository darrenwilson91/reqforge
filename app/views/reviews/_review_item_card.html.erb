<%= link_to project_review_review_item_path(project, review, item), class: "block rf-card-padded hover:border-brand-accent/40 hover:shadow-sm transition-all group" do %>
  <div class="flex items-start justify-between">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2">
        <span class="rf-uid"><%= item.requirement.uid %></span>
        <span class="<%= review_item_status_badge_class(item) %>"><%= item.status.humanize %></span>
        <% if item.changed_since_snapshot? %>
          <span class="rf-badge bg-orange-50 text-orange-700">Changed</span>
        <% end %>
      </div>
      <h3 class="mt-1.5 text-sm font-medium text-slate-900 group-hover:text-brand-accent transition-colors"><%= item.requirement.title %></h3>
      <div class="flex items-center gap-3 mt-2 text-xs text-slate-400">
        <span><%= item.requirement.section&.requirement_module&.name %></span>
        <span><%= item.review_comments.size %> comment<%= item.review_comments.size == 1 ? "" : "s" %></span>
      </div>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-300 group-hover:text-brand-accent transition-colors shrink-0" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
  </div>
<% end %>
