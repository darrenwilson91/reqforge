<div class="rf-card-padded text-center">
  <div class="text-2xl font-semibold text-slate-900"><%= progress[:total] %></div>
  <div class="text-xs text-slate-500 mt-1">Total Items</div>
</div>
<div class="rf-card-padded text-center">
  <div class="text-2xl font-semibold text-emerald-600"><%= review_items.select(&:approved?).size %></div>
  <div class="text-xs text-slate-500 mt-1">Approved</div>
</div>
<div class="rf-card-padded text-center">
  <div class="text-2xl font-semibold text-red-600"><%= review_items.select(&:rejected?).size %></div>
  <div class="text-xs text-slate-500 mt-1">Rejected</div>
</div>
<div class="rf-card-padded text-center">
  <% pct = progress[:percentage] %>
  <div class="text-2xl font-semibold text-slate-900"><%= pct %>%</div>
  <div class="text-xs text-slate-500 mt-1">Progress</div>
  <div class="w-full h-1.5 bg-slate-100 rounded-full mt-2 overflow-hidden">
    <div class="h-full rounded-full transition-all <%= review_progress_bar_color(pct) %>" style="width: <%= pct %>%"></div>
  </div>
</div>
