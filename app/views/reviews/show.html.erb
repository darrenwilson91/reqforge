<%= turbo_stream_from @review %>

<div class="max-w-7xl mx-auto px-6 py-8">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
    <%= link_to "Projects", projects_path, class: "hover:text-brand-accent transition-colors" %>
    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
    <%= link_to @project.name, project_path(@project), class: "hover:text-brand-accent transition-colors" %>
    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
    <%= link_to "Reviews", project_reviews_path(@project), class: "hover:text-brand-accent transition-colors" %>
    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
    <span class="text-slate-700 font-medium truncate"><%= @review.title %></span>
  </nav>

  <!-- Header -->
  <div class="flex items-start justify-between mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold text-slate-900"><%= @review.title %></h1>
        <span id="review_status_<%= @review.id %>" class="<%= review_status_badge_class(@review) %>"><%= @review.status.humanize %></span>
      </div>
      <% if @review.description.present? %>
        <p class="mt-2 text-sm text-slate-500 max-w-2xl"><%= @review.description %></p>
      <% end %>
      <div class="flex items-center gap-4 mt-3 text-xs text-slate-400">
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
          </svg>
          Created by <%= @review.created_by.full_name %>
        </span>
        <span>Created <%= time_ago_in_words(@review.created_at) %> ago</span>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <% if policy(@review).update? && @review.draft? %>
        <%= link_to edit_project_review_path(@project, @review), class: "rf-btn-secondary text-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
          </svg>
          Edit
        <% end %>
      <% end %>
      <% if policy(@review).destroy? %>
        <%= link_to project_review_path(@project, @review), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this review?" }, class: "rf-btn-danger text-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Status Transitions -->
  <% if policy(@review).transition_status? && @review.available_transitions.any? %>
    <div class="rf-card-padded mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <h3 class="text-sm font-medium text-slate-700">Workflow</h3>
          <span class="text-xs text-slate-400">
            Current: <span class="font-medium text-slate-600"><%= @review.status.humanize %></span>
          </span>
        </div>
        <div class="flex items-center gap-2">
          <% @review.available_transitions.each do |transition| %>
            <% confirm = transition == "cancelled" ? "Are you sure you want to cancel this review?" : nil %>
            <%= link_to review_transition_label(transition),
              transition_status_project_review_path(@project, @review, status: transition),
              data: { turbo_method: :patch, turbo_confirm: confirm },
              class: "#{review_transition_button_class(transition)} text-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Stats Row -->
  <div id="review_stats_<%= @review.id %>" class="grid grid-cols-4 gap-4 mb-6">
    <%= render partial: "reviews/review_stats", locals: { progress: @progress, review_items: @review_items } %>
  </div>

  <!-- Outcome Banner (shown when review is completed) -->
  <div id="review_outcome_<%= @review.id %>">
  <% if @review.completed? && @outcome %>
    <% config = review_outcome_config(@outcome) %>
    <% if config %>
      <div class="rounded-lg border p-4 mb-6 flex items-center gap-4 <%= config[:bg] %>" data-testid="review-outcome">
        <% if @outcome == :approved %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0 <%= config[:icon_color] %>" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        <% elsif @outcome == :rejected %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0 <%= config[:icon_color] %>" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0 <%= config[:icon_color] %>" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        <% end %>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-semibold text-slate-900">Review Outcome</h3>
            <span class="<%= config[:badge] %>"><%= config[:label] %></span>
          </div>
          <p class="text-sm text-slate-600 mt-0.5"><%= config[:description] %></p>
        </div>
      </div>
    <% end %>
  <% end %>
  </div>

  <div class="grid grid-cols-3 gap-6">
    <!-- Review Items (2/3) -->
    <div class="col-span-2 space-y-3">
      <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Review Items</h2>
      <% if @review_items.any? %>
        <% @review_items.each do |item| %>
          <div id="review_item_card_<%= item.id %>">
            <%= render partial: "reviews/review_item_card", locals: { item: item, project: @project, review: @review } %>
          </div>
        <% end %>
      <% else %>
        <div class="rf-card-padded text-center py-8">
          <p class="text-sm text-slate-500">No items in this review.</p>
        </div>
      <% end %>
    </div>

    <!-- Participants (1/3) -->
    <div class="space-y-3">
      <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Participants</h2>
      <% if @participants.any? %>
        <div class="rf-card-padded space-y-3">
          <% @participants.each do |participant| %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 text-slate-600 text-xs font-medium">
                  <%= participant.user.first_name[0] %><%= participant.user.last_name[0] %>
                </div>
                <span class="text-sm text-slate-700"><%= participant.user.full_name %></span>
              </div>
              <span class="<%= participant_role_badge_class(participant) %> text-xs"><%= participant.role.humanize %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rf-card-padded text-center py-6">
          <p class="text-sm text-slate-500">No participants added.</p>
        </div>
      <% end %>

      <!-- Share Link Panel -->
      <% if policy(@review).update? %>
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider mt-6">Share Link</h2>
        <div class="rf-card-padded">
          <% if @review.shared? %>
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-sm text-slate-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                </svg>
                <span>External link active</span>
              </div>

              <div data-controller="clipboard">
                <input type="text"
                       readonly
                       value="<%= public_review_url(@review.share_token) %>"
                       class="rf-input text-xs font-mono w-full bg-slate-50"
                       data-clipboard-target="source">
                <div class="flex items-center gap-2 mt-2">
                  <button type="button"
                          data-action="click->clipboard#copy"
                          data-clipboard-target="button"
                          class="rf-btn-secondary text-xs flex-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
                      <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
                    </svg>
                    Copy Link
                  </button>
                  <%= link_to revoke_share_token_project_review_path(@project, @review),
                    data: { turbo_method: :delete, turbo_confirm: "Revoke this share link? Anyone with the link will no longer be able to access this review." },
                    class: "rf-btn-danger text-xs" do %>
                    Revoke
                  <% end %>
                </div>
              </div>

              <p class="text-xs text-slate-400">Anyone with this link can view the review read-only, without signing in.</p>
            </div>
          <% else %>
            <div class="text-center py-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <p class="text-sm text-slate-500 mb-3">Share this review with external stakeholders.</p>
              <%= link_to generate_share_token_project_review_path(@project, @review),
                data: { turbo_method: :post },
                class: "rf-btn-primary text-sm" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                </svg>
                Generate Share Link
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
