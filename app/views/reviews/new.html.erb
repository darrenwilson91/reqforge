<% content_for(:page_title, "New Review — #{@project.name}") %>

<div class="max-w-3xl mx-auto space-y-6">
  <%= breadcrumbs(["Projects", projects_path], [@project.name, project_path(@project)], ["Reviews", project_reviews_path(@project)], "New Review") %>

  <h1 class="text-2xl font-bold text-slate-900">Create Review</h1>

  <%= render "form", review: @review %>
</div>
