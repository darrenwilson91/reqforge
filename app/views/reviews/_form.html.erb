<%= form_with(model: [@project, review], class: "space-y-6") do |f| %>
  <% if review.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 p-4">
      <div class="flex items-center gap-2 text-sm font-medium text-red-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <%= pluralize(review.errors.count, "error") %> prevented this review from being saved:
      </div>
      <ul class="mt-2 ml-7 list-disc text-sm text-red-700">
        <% review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Title & Description -->
  <div class="rf-card-padded space-y-4">
    <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Review Details</h3>

    <div>
      <%= f.label :title, class: "rf-label" %>
      <%= f.text_field :title, class: "rf-input mt-1", placeholder: "e.g., Sprint 3 Requirements Review" %>
    </div>

    <div>
      <%= f.label :description, class: "rf-label" %>
      <%= f.text_area :description, class: "rf-input mt-1", rows: 3, placeholder: "Describe the purpose and scope of this review..." %>
    </div>
  </div>

  <!-- Select Requirements -->
  <div class="rf-card-padded space-y-4" data-controller="review-select">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Requirements to Review</h3>
      <div class="flex items-center gap-2">
        <button type="button" data-action="review-select#selectAll" class="text-xs text-brand-accent hover:text-brand-accent-dark transition-colors font-medium">Select All</button>
        <span class="text-slate-300">|</span>
        <button type="button" data-action="review-select#deselectAll" class="text-xs text-slate-500 hover:text-slate-700 transition-colors font-medium">Deselect All</button>
      </div>
    </div>

    <% if @requirements.any? %>
      <div class="divide-y divide-slate-100 max-h-80 overflow-y-auto rounded-lg border border-slate-200">
        <% @requirements.group_by { |r| r.section&.requirement_module&.name || "Unassigned" }.each do |module_name, reqs| %>
          <div class="px-3 py-2 bg-slate-50 sticky top-0">
            <span class="text-xs font-medium text-slate-500 uppercase tracking-wider"><%= module_name %></span>
          </div>
          <% reqs.each do |req| %>
            <label class="flex items-center gap-3 px-3 py-2.5 hover:bg-slate-50 cursor-pointer transition-colors" data-review-select-target="item">
              <input type="checkbox" name="review[requirement_ids][]" value="<%= req.id %>"
                     class="rounded border-slate-300 text-brand-accent focus:ring-brand-accent"
                     data-review-select-target="checkbox"
                     data-action="change->review-select#toggle">
              <span class="rf-uid text-xs"><%= req.uid %></span>
              <span class="text-sm text-slate-700 truncate flex-1"><%= req.title %></span>
              <span class="rf-badge bg-slate-100 text-slate-500 text-xs"><%= req.status.humanize %></span>
            </label>
          <% end %>
        <% end %>
      </div>
      <p class="text-xs text-slate-400" data-review-select-target="count">0 requirements selected</p>
    <% else %>
      <div class="text-center py-6">
        <p class="text-sm text-slate-500">No requirements in this project yet.</p>
        <%= link_to "Create requirements first", project_requirements_path(@project), class: "text-sm text-brand-accent hover:text-brand-accent-dark transition-colors" %>
      </div>
    <% end %>
  </div>

  <!-- Participants -->
  <div class="rf-card-padded space-y-4">
    <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">Participants</h3>
    <p class="text-xs text-slate-400">You will be added as the review author automatically.</p>

    <% if @organization_members.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="rf-label">Reviewers</label>
          <div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-slate-200 rounded-lg p-2">
            <% @organization_members.each do |member| %>
              <label class="flex items-center gap-2 px-2 py-1.5 rounded hover:bg-slate-50 cursor-pointer">
                <input type="checkbox" name="review[reviewer_ids][]" value="<%= member.id %>"
                       class="rounded border-slate-300 text-violet-600 focus:ring-violet-500">
                <span class="text-sm text-slate-700"><%= member.full_name %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <label class="rf-label">Approvers</label>
          <div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-slate-200 rounded-lg p-2">
            <% @organization_members.each do |member| %>
              <label class="flex items-center gap-2 px-2 py-1.5 rounded hover:bg-slate-50 cursor-pointer">
                <input type="checkbox" name="review[approver_ids][]" value="<%= member.id %>"
                       class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500">
                <span class="text-sm text-slate-700"><%= member.full_name %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-slate-500">No other organization members to add as participants.</p>
    <% end %>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-3">
    <%= f.submit review.persisted? ? "Update Review" : "Create Review", class: "rf-btn-primary cursor-pointer" %>
    <%= link_to "Cancel",
      review.persisted? ? project_review_path(@project, review) : project_reviews_path(@project),
      class: "rf-btn-secondary" %>
  </div>
<% end %>
