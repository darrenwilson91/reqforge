<% content_for(:page_title, "Edit Review — #{@project.name}") %>

<div class="max-w-3xl mx-auto space-y-6">
  <%= breadcrumbs(["Projects", projects_path], [@project.name, project_path(@project)], ["Reviews", project_reviews_path(@project)], [@review.title, project_review_path(@project, @review)], "Edit") %>

  <h1 class="text-2xl font-bold text-slate-900">Edit Review</h1>

  <%= render "form", review: @review %>
</div>
