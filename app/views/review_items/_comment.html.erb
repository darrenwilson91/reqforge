<%# Supports both inline rendering (with instance variables) and broadcast rendering (with locals) %>
<% project = local_assigns[:project] || @project %>
<% review = local_assigns[:review] || @review %>
<% review_item = local_assigns[:review_item] || @review_item %>
<% can_reply = local_assigns.key?(:can_reply) ? local_assigns[:can_reply] : @participant&.can_comment? %>

<div id="comment-<%= comment.id %>" class="<%= depth > 0 ? 'ml-6 border-l-2 border-slate-100 pl-4' : '' %>" data-controller="review-comment">
  <div class="rf-card overflow-hidden <%= comment.resolved? ? 'opacity-60' : '' %>">
    <!-- Comment header -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50 border-b border-slate-200">
      <div class="flex items-center gap-2">
        <div class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-200 text-slate-600 text-xs font-medium">
          <%= comment.user.first_name[0] %><%= comment.user.last_name[0] %>
        </div>
        <span class="text-sm font-medium text-slate-700"><%= comment.user.full_name %></span>
        <span class="text-xs text-slate-400"><%= time_ago_in_words(comment.created_at) %> ago</span>
      </div>
      <div class="flex items-center gap-2">
        <% if comment.resolved? %>
          <span class="rf-badge bg-emerald-50 text-emerald-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 mr-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Resolved
          </span>
          <%= link_to unresolve_project_review_review_item_review_comment_path(project, review, review_item, comment),
            data: { turbo_method: :patch },
            class: "text-xs text-slate-400 hover:text-slate-600 transition-colors",
            title: "Reopen this comment" do %>
            Reopen
          <% end %>
        <% else %>
          <%= link_to resolve_project_review_review_item_review_comment_path(project, review, review_item, comment),
            data: { turbo_method: :patch },
            class: "text-xs text-slate-400 hover:text-emerald-600 transition-colors",
            title: "Mark as resolved" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Comment body -->
    <div class="px-4 py-3">
      <p class="text-sm text-slate-700 whitespace-pre-wrap"><%= comment.body %></p>
    </div>

    <!-- Comment actions -->
    <% if can_reply && depth < 3 %>
      <div class="px-4 pb-3">
        <button data-action="click->review-comment#toggleReply" class="text-xs text-slate-400 hover:text-brand-accent transition-colors">
          Reply
        </button>

        <!-- Inline reply form -->
        <div class="hidden mt-3" data-review-comment-target="replyForm">
          <%= form_with(model: [project, review, review_item, ReviewComment.new],
            url: project_review_review_item_review_comments_path(project, review, review_item),
            class: "space-y-2") do |f| %>
            <%= f.hidden_field :parent_comment_id, value: comment.id %>
            <%= f.text_area :body,
              placeholder: "Write a reply...",
              rows: 2,
              class: "rf-input text-sm resize-none",
              data: { review_comment_target: "replyBody" } %>
            <div class="flex items-center gap-2 justify-end">
              <button type="button" data-action="click->review-comment#cancelReply" class="text-xs text-slate-400 hover:text-slate-600 transition-colors">Cancel</button>
              <%= f.submit "Reply", class: "rf-btn-primary text-xs py-1 px-3 cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if comment.resolved? && comment.resolved_by.present? %>
      <div class="px-4 pb-2.5 text-xs text-slate-400">
        Resolved by <%= comment.resolved_by.full_name %> <%= time_ago_in_words(comment.resolved_at) %> ago
      </div>
    <% end %>
  </div>

  <!-- Threaded replies -->
  <% if comment.replies.loaded? ? comment.replies.any? : comment.replies.exists? %>
    <div class="mt-2 space-y-2">
      <% comment.replies.order(created_at: :asc).each do |reply| %>
        <%= render partial: "review_items/comment", locals: { comment: reply, depth: depth + 1, project: project, review: review, review_item: review_item, can_reply: can_reply } %>
      <% end %>
    </div>
  <% end %>
</div>
