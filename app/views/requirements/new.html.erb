<% content_for(:page_title, "New Requirement") %>

<div class="space-y-6">
  <%= breadcrumbs(["Projects", projects_path], [@project.name, project_path(@project)], ["Requirements", project_requirements_path(@project)], "New") %>

  <div class="max-w-2xl">
    <h1 class="text-2xl font-bold text-slate-900 mb-1">New Requirement</h1>
    <p class="text-sm text-slate-500 mb-6">Add a new requirement to <span class="font-medium text-slate-700"><%= @project.name %></span>. A unique ID will be generated automatically.</p>

    <%= render "form", requirement: @requirement %>
  </div>
</div>
