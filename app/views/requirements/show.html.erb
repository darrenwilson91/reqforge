<% content_for(:page_title, "#{@requirement.uid} — #{@requirement.title}") %>

<div class="space-y-4">
  <%# Breadcrumb %>
  <nav class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "Projects", projects_path, class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to @project.name, project_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to "Requirements", project_requirements_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <span class="text-slate-900 font-medium"><%= @requirement.uid %></span>
  </nav>

  <%# Two-panel layout: tree + detail %>
  <div class="flex gap-6 items-start">
    <%# Left panel — hierarchy tree %>
    <div class="w-72 shrink-0 rf-card overflow-hidden sticky top-4">
      <%= render partial: "requirements/tree" %>
    </div>

    <%# Right panel — requirement detail (Turbo Frame for inline editing) %>
    <div class="flex-1 min-w-0">
      <%= turbo_frame_tag "requirement_detail" do %>
        <% if action_name == "edit" || (action_name == "update" && @requirement.errors.any?) %>
          <%= render partial: "requirements/edit_detail", locals: { requirement: @requirement, project: @project } %>
        <% else %>
          <%= render partial: "requirements/detail", locals: { requirement: @requirement, project: @project } %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
