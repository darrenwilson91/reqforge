<% content_for(:page_title, "#{@requirement.uid} — #{@requirement.title}") %>

<div class="space-y-6">
  <%# Breadcrumb %>
  <nav class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "Projects", projects_path, class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to @project.name, project_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to "Requirements", project_requirements_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <span class="text-slate-900 font-medium"><%= @requirement.uid %></span>
  </nav>

  <%# Requirement Header %>
  <div class="rf-card-padded">
    <div class="flex items-start justify-between">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span class="rf-uid text-sm"><%= @requirement.uid %></span>
          <span class="<%= requirement_status_badge_class(@requirement) %>"><%= @requirement.status.humanize %></span>
          <span class="<%= requirement_type_badge_class(@requirement) %>"><%= @requirement.requirement_type.humanize %></span>
          <span class="<%= requirement_priority_badge_class(@requirement) %>"><%= @requirement.priority.humanize %></span>
          <span class="<%= asil_badge_class(@requirement) %>"><%= @requirement.asil_level.upcase.sub("_", " ") %></span>
        </div>
        <h1 class="text-2xl font-bold text-slate-900"><%= @requirement.title %></h1>
        <div class="mt-2 text-xs text-slate-400">
          <% if @requirement.section&.requirement_module %>
            <span class="font-medium text-slate-500"><%= @requirement.section.requirement_module.name %></span>
            <span class="mx-1">/</span>
          <% end %>
          <span><%= @requirement.section&.name %></span>
          <span class="mx-2">&middot;</span>
          Created by <%= @requirement.created_by&.full_name || "Unknown" %>
          <span class="mx-2">&middot;</span>
          <%= @requirement.created_at.strftime("%b %-d, %Y at %l:%M %p") %>
          <% if @requirement.updated_at != @requirement.created_at %>
            <span class="mx-2">&middot;</span>
            Updated <%= time_ago_in_words(@requirement.updated_at) %> ago
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0 ml-4">
        <% if policy(@requirement).update? %>
          <%= link_to edit_project_requirement_path(@project, @requirement), class: "rf-btn-secondary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
            </svg>
            Edit
          <% end %>
        <% end %>
        <% if policy(@requirement).destroy? %>
          <%= button_to project_requirement_path(@project, @requirement), method: :delete, class: "rf-btn-danger",
              data: { turbo_confirm: "Are you sure you want to delete this requirement? This action cannot be undone." } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            Delete
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Body %>
  <% if @requirement.body.present? %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Description</h2>
      </div>
      <div class="p-5">
        <div class="prose prose-sm prose-slate max-w-none"><%= simple_format(@requirement.body) %></div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%# Attributes Card %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Attributes</h2>
      </div>
      <div class="p-5">
        <dl class="grid grid-cols-2 gap-4">
          <div>
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Type</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @requirement.requirement_type.humanize %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Status</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @requirement.status.humanize %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Priority</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @requirement.priority.humanize %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">ASIL Level</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @requirement.asil_level.upcase.sub("_", " ") %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Module</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @requirement.section&.requirement_module&.name || "—" %></dd>
          </div>
          <div>
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Section</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @requirement.section&.name || "—" %></dd>
          </div>
        </dl>
      </div>
    </div>

    <%# Custom Attributes Card %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Custom Attributes</h2>
      </div>
      <div class="p-5">
        <% if @requirement.custom_attributes.present? && @requirement.custom_attributes.any? %>
          <dl class="grid grid-cols-2 gap-4">
            <% @requirement.custom_attributes.each do |key, value| %>
              <div>
                <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider"><%= key %></dt>
                <dd class="mt-1 text-sm text-slate-900"><%= value.presence || "—" %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="text-sm text-slate-400">No custom attributes defined.</p>
        <% end %>
      </div>
    </div>
  </div>

  <%# Traceability Links %>
  <div class="rf-card">
    <div class="p-5 border-b border-slate-100">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-900">Traceability Links</h2>
        <span class="text-xs text-slate-400"><%= @requirement.outgoing_links.count + @requirement.incoming_links.count %> links</span>
      </div>
    </div>
    <% outgoing = @requirement.outgoing_links.includes(:target_requirement) %>
    <% incoming = @requirement.incoming_links.includes(:source_requirement) %>
    <% if outgoing.any? || incoming.any? %>
      <div class="divide-y divide-slate-100">
        <% outgoing.each do |link| %>
          <div class="p-4 flex items-center gap-3 hover:bg-slate-50/50 transition-colors">
            <div class="flex items-center justify-center w-6 h-6 rounded bg-blue-50 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <span class="rf-badge bg-slate-100 text-slate-600 text-xs"><%= link.link_type.humanize %></span>
              <span class="mx-1 text-slate-300">&rarr;</span>
              <%= link_to project_requirement_path(@project, link.target_requirement) do %>
                <span class="rf-uid text-xs"><%= link.target_requirement.uid %></span>
                <span class="text-sm text-slate-700 hover:text-brand-accent-dark ml-1"><%= link.target_requirement.title %></span>
              <% end %>
            </div>
            <% if link.ai_suggested? %>
              <span class="rf-badge bg-violet-50 text-violet-600 text-xs">AI</span>
            <% end %>
          </div>
        <% end %>
        <% incoming.each do |link| %>
          <div class="p-4 flex items-center gap-3 hover:bg-slate-50/50 transition-colors">
            <div class="flex items-center justify-center w-6 h-6 rounded bg-emerald-50 text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <%= link_to project_requirement_path(@project, link.source_requirement) do %>
                <span class="rf-uid text-xs"><%= link.source_requirement.uid %></span>
                <span class="text-sm text-slate-700 hover:text-brand-accent-dark ml-1"><%= link.source_requirement.title %></span>
              <% end %>
              <span class="mx-1 text-slate-300">&rarr;</span>
              <span class="rf-badge bg-slate-100 text-slate-600 text-xs"><%= link.link_type.humanize %></span>
            </div>
            <% if link.ai_suggested? %>
              <span class="rf-badge bg-violet-50 text-violet-600 text-xs">AI</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rf-empty-state py-8">
        <p class="text-sm text-slate-400">No traceability links yet.</p>
      </div>
    <% end %>
  </div>

  <%# Version History %>
  <div class="rf-card">
    <div class="p-5 border-b border-slate-100">
      <h2 class="text-base font-semibold text-slate-900">Version History</h2>
    </div>
    <% if @requirement.versions.any? %>
      <div class="divide-y divide-slate-100">
        <% @requirement.versions.order(created_at: :desc).limit(10).each do |version| %>
          <div class="p-4 flex items-center gap-3">
            <div class="flex items-center justify-center w-6 h-6 rounded bg-slate-100 text-slate-500">
              <span class="text-xs font-mono font-medium">v<%= version.index || 0 %></span>
            </div>
            <div class="flex-1 min-w-0">
              <span class="text-sm font-medium text-slate-700"><%= version.event.capitalize %></span>
              <span class="text-xs text-slate-400 ml-2"><%= version.created_at.strftime("%b %-d, %Y at %l:%M %p") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rf-empty-state py-8">
        <p class="text-sm text-slate-400">No version history available.</p>
      </div>
    <% end %>
  </div>
</div>
