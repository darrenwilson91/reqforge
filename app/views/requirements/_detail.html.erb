<%# Requirement detail view — rendered inside turbo_frame "requirement_detail" %>
<div class="space-y-6">
  <%# Requirement Header %>
  <div class="rf-card-padded">
    <div class="flex items-start justify-between">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span class="rf-uid text-sm"><%= requirement.uid %></span>
          <span class="<%= requirement_status_badge_class(requirement) %>"><%= requirement.status.humanize %></span>
          <span class="<%= requirement_type_badge_class(requirement) %>"><%= requirement.requirement_type.humanize %></span>
          <span class="<%= requirement_priority_badge_class(requirement) %>"><%= requirement.priority.humanize %></span>
          <span class="<%= asil_badge_class(requirement) %>"><%= requirement.asil_level.upcase.sub("_", " ") %></span>
        </div>
        <h1 class="text-2xl font-bold text-slate-900"><%= requirement.title %></h1>
      </div>

      <div class="flex items-center gap-2 shrink-0 ml-4">
        <% if policy(requirement).update? %>
          <%= link_to edit_project_requirement_path(project, requirement), class: "rf-btn-secondary", data: { turbo_frame: "requirement_detail", keyboard_shortcut: "edit-requirement" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
            </svg>
            Edit
          <% end %>
        <% end %>
        <% if policy(requirement).destroy? %>
          <%= button_to project_requirement_path(project, requirement), method: :delete, class: "rf-btn-danger",
              data: { turbo_confirm: "Are you sure you want to delete this requirement? This action cannot be undone." } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            Delete
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Metadata row %>
    <div class="mt-3 flex items-center gap-4 text-xs text-slate-400 flex-wrap">
      <% if requirement.section&.requirement_module %>
        <span class="inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
          </svg>
          <span class="font-medium text-slate-500"><%= requirement.section.requirement_module.name %></span>
          <span class="text-slate-300">/</span>
          <span><%= requirement.section.name %></span>
        </span>
      <% end %>
      <span class="inline-flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
        </svg>
        <%= requirement.created_by&.full_name || "Unknown" %>
      </span>
      <span class="inline-flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
        </svg>
        Created <%= requirement.created_at.strftime("%b %-d, %Y") %>
      </span>
      <% if requirement.updated_at != requirement.created_at %>
        <span class="inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.828a1 1 0 101.415-1.414L11 9.586V6z" clip-rule="evenodd" />
          </svg>
          Updated <%= time_ago_in_words(requirement.updated_at) %> ago
        </span>
      <% end %>
      <% version_count = requirement.versions.count %>
      <% if version_count > 0 %>
        <span class="inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
          </svg>
          <%= version_count %> <%= "revision".pluralize(version_count) %>
        </span>
      <% end %>
    </div>
  </div>

  <%# Status Workflow %>
  <%= render "requirements/status_workflow", requirement: requirement, project: project %>

  <%# Description %>
  <% if requirement.body.present? %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Description</h2>
      </div>
      <div class="p-5">
        <div class="rf-rich-text"><%= sanitize(requirement.body, tags: %w[div p br strong em b i u a ul ol li blockquote pre code del s h1 figure figcaption], attributes: %w[href target class]) %></div>
      </div>
    </div>
  <% end %>

  <%# Attributes + Custom Attributes side by side %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%# Core Attributes %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Attributes</h2>
      </div>
      <div class="p-5">
        <dl class="space-y-3">
          <div class="flex items-center justify-between py-1">
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Type</dt>
            <dd><span class="<%= requirement_type_badge_class(requirement) %>"><%= requirement.requirement_type.humanize %></span></dd>
          </div>
          <div class="border-t border-slate-50"></div>
          <div class="flex items-center justify-between py-1">
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Status</dt>
            <dd><span class="<%= requirement_status_badge_class(requirement) %>"><%= requirement.status.humanize %></span></dd>
          </div>
          <div class="border-t border-slate-50"></div>
          <div class="flex items-center justify-between py-1">
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Priority</dt>
            <dd><span class="<%= requirement_priority_badge_class(requirement) %>"><%= requirement.priority.humanize %></span></dd>
          </div>
          <div class="border-t border-slate-50"></div>
          <div class="flex items-center justify-between py-1">
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">ASIL Level</dt>
            <dd><span class="<%= asil_badge_class(requirement) %>"><%= requirement.asil_level.upcase.sub("_", " ") %></span></dd>
          </div>
          <div class="border-t border-slate-50"></div>
          <div class="flex items-center justify-between py-1">
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Module</dt>
            <dd class="text-sm text-slate-700"><%= requirement.section&.requirement_module&.name || "—" %></dd>
          </div>
          <div class="border-t border-slate-50"></div>
          <div class="flex items-center justify-between py-1">
            <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider">Section</dt>
            <dd class="text-sm text-slate-700"><%= requirement.section&.name || "—" %></dd>
          </div>
        </dl>
      </div>
    </div>

    <%# Custom Attributes %>
    <div class="rf-card">
      <div class="p-5 border-b border-slate-100">
        <h2 class="text-base font-semibold text-slate-900">Custom Attributes</h2>
      </div>
      <div class="p-5">
        <% if requirement.custom_attributes.present? && requirement.custom_attributes.any? %>
          <dl class="space-y-3">
            <% requirement.custom_attributes.each do |key, value| %>
              <div class="flex items-center justify-between py-1">
                <dt class="text-xs font-medium text-slate-400 uppercase tracking-wider"><%= key %></dt>
                <dd class="text-sm text-slate-700"><%= value.presence || "—" %></dd>
              </div>
              <% unless key == requirement.custom_attributes.keys.last %>
                <div class="border-t border-slate-50"></div>
              <% end %>
            <% end %>
          </dl>
        <% else %>
          <div class="rf-empty-state py-6">
            <p class="text-sm text-slate-400">No custom attributes defined.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# AI Analysis Panel %>
  <%= render "requirements/ai_panel", requirement: requirement, project: project %>

  <%# Traceability Links — grouped by link type %>
  <%= render "requirements/traceability_panel", requirement: requirement, project: project %>

  <%# Version History %>
  <%= render "requirements/version_history", requirement: requirement %>
</div>
