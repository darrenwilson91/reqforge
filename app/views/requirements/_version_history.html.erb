<%# Version history panel with expandable diff entries %>
<% versions = requirement.versions.order(created_at: :desc).limit(20) %>
<div class="rf-card" data-controller="version-history">
  <div class="p-5 border-b border-slate-100">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold text-slate-900">Version History</h2>
      <div class="flex items-center gap-3">
        <% if versions.any? %>
          <span class="text-xs text-slate-400"><%= requirement.versions.count %> <%= "revision".pluralize(requirement.versions.count) %></span>
          <div class="flex items-center gap-1">
            <button type="button" data-action="version-history#expandAll"
                    class="text-xs text-slate-400 hover:text-brand-accent-dark transition-colors px-1.5 py-0.5 rounded hover:bg-slate-50">
              Expand all
            </button>
            <span class="text-slate-200">|</span>
            <button type="button" data-action="version-history#collapseAll"
                    class="text-xs text-slate-400 hover:text-brand-accent-dark transition-colors px-1.5 py-0.5 rounded hover:bg-slate-50">
              Collapse all
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if versions.any? %>
    <div class="divide-y divide-slate-100">
      <% versions.each_with_index do |version, idx| %>
        <% diffs = VersionDiff.new(version).compute %>
        <div data-version-history-target="entry">
          <%# Version header — clickable to expand %>
          <button type="button"
                  class="w-full px-5 py-3 flex items-center gap-3 hover:bg-slate-50/50 transition-colors text-left"
                  data-action="version-history#toggle"
                  data-version-history-index-param="<%= idx %>">
            <%# Expand chevron %>
            <svg data-version-history-target="chevron"
                 xmlns="http://www.w3.org/2000/svg"
                 class="w-3.5 h-3.5 text-slate-400 transition-transform duration-150 shrink-0"
                 viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>

            <%# Version badge %>
            <div class="flex items-center justify-center w-7 h-7 rounded-full <%= idx == 0 ? 'bg-brand-accent-subtle text-brand-accent-dark' : 'bg-slate-100 text-slate-500' %> shrink-0">
              <span class="text-xs font-mono font-semibold">v<%= version.index || 0 %></span>
            </div>

            <%# Version info %>
            <div class="flex-1 min-w-0">
              <span class="text-sm font-medium text-slate-700"><%= version.event.capitalize %></span>
              <% if diffs.any? %>
                <span class="text-xs text-slate-400 ml-2">
                  (<%= diffs.map { |d| d.field.humanize }.join(", ") %>)
                </span>
              <% end %>
            </div>

            <%# Diff stats %>
            <% if diffs.any? %>
              <span class="rf-badge bg-slate-100 text-slate-500 text-xs shrink-0">
                <%= diffs.size %> <%= "field".pluralize(diffs.size) %>
              </span>
            <% end %>

            <%# Timestamp %>
            <span class="text-xs text-slate-400 shrink-0"><%= version.created_at.strftime("%b %-d, %Y %l:%M %p") %></span>
          </button>

          <%# Expandable diff content — hidden by default %>
          <div data-version-history-target="content" class="hidden">
            <% if diffs.any? %>
              <div class="mx-5 mb-4 rounded-lg border border-slate-200 overflow-hidden">
                <% diffs.each_with_index do |diff, didx| %>
                  <% unless didx == 0 %><div class="border-t border-slate-200"></div><% end %>
                  <div class="bg-slate-50/50">
                    <%# Field name header %>
                    <div class="px-4 py-2 bg-slate-50 border-b border-slate-200">
                      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= diff.field.humanize %></span>
                    </div>

                    <% if diff.diff_html.present? %>
                      <%# Word-level diff view for text fields %>
                      <div class="px-4 py-3">
                        <div class="text-sm text-slate-700 leading-relaxed rf-diff-content">
                          <%= diff.diff_html %>
                        </div>
                      </div>
                    <% else %>
                      <%# Side-by-side old → new for enum/short fields %>
                      <div class="px-4 py-3 flex items-center gap-3">
                        <span class="inline-flex items-center gap-1.5">
                          <span class="rf-diff-old-badge"><%= diff.old_value %></span>
                        </span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                        <span class="inline-flex items-center gap-1.5">
                          <span class="rf-diff-new-badge"><%= diff.new_value %></span>
                        </span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="mx-5 mb-4 py-3 text-center">
                <span class="text-xs text-slate-400">No detailed changes recorded for this version.</span>
              </div>
            <% end %>

            <%# Whodunnit info if available %>
            <% if version.whodunnit.present? %>
              <% author = User.find_by(id: version.whodunnit) %>
              <% if author %>
                <div class="mx-5 mb-3 flex items-center gap-1.5 text-xs text-slate-400">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                  </svg>
                  <span>by <%= author.full_name %></span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# "Show more" note if versions are truncated %>
    <% if requirement.versions.count > 20 %>
      <div class="px-5 py-3 border-t border-slate-100 text-center">
        <span class="text-xs text-slate-400">Showing latest 20 of <%= requirement.versions.count %> revisions</span>
      </div>
    <% end %>
  <% else %>
    <div class="rf-empty-state py-8">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300 mx-auto mb-2" viewBox="0 0 20 20" fill="currentColor">
        <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
        <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
      </svg>
      <p class="text-sm text-slate-400">No version history yet.</p>
      <p class="text-xs text-slate-300 mt-1">Changes will be tracked automatically when this requirement is edited.</p>
    </div>
  <% end %>
</div>
