<% content_for(:page_title, "Edit #{@requirement.uid}") %>

<div class="space-y-6">
  <%# Breadcrumb %>
  <nav class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "Projects", projects_path, class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to @project.name, project_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to "Requirements", project_requirements_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to @requirement.uid, project_requirement_path(@project, @requirement), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <span class="text-slate-900 font-medium">Edit</span>
  </nav>

  <div class="max-w-2xl">
    <h1 class="text-2xl font-bold text-slate-900 mb-1">Edit Requirement</h1>
    <p class="text-sm text-slate-500 mb-6">
      <span class="rf-uid"><%= @requirement.uid %></span>
      <span class="ml-2"><%= @requirement.title %></span>
    </p>

    <%= render "form", requirement: @requirement %>
  </div>
</div>
