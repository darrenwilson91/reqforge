<%# Test Cases panel — shows linked test cases with status and quick-add button %>
<% test_cases = requirement.test_cases.order(:uid) %>

<div class="rf-card">
  <div class="p-5 border-b border-slate-100 dark:border-slate-700">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Test Cases</h2>
        <% if test_cases.any? %>
          <span class="rf-badge bg-brand-accent-subtle text-brand-accent-dark"><%= test_cases.size %></span>
        <% end %>
      </div>
      <% if policy(::TestCase.new(project: project)).create? %>
        <%= link_to new_project_test_case_path(project, requirement_id: requirement.id), class: "inline-flex items-center gap-1.5 text-xs font-medium text-brand-accent hover:text-brand-accent-dark transition-colors", data: { turbo_frame: "_top" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Add Test Case
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="p-5">
    <% if test_cases.any? %>
      <div class="space-y-2">
        <% test_cases.each do |tc| %>
          <%= link_to project_test_case_path(project, tc), class: "group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
            <div class="shrink-0">
              <%= test_status_icon(tc) %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="rf-uid text-xs"><%= tc.uid %></span>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-200 truncate"><%= tc.title %></span>
              </div>
            </div>
            <div class="shrink-0 flex items-center gap-1.5">
              <span class="<%= test_type_badge_class(tc) %> text-[10px]"><%= tc.test_type.humanize %></span>
              <span class="<%= test_status_badge_class(tc) %> text-[10px]"><%= tc.status.humanize %></span>
            </div>
          <% end %>
        <% end %>
      </div>

      <%# Summary bar %>
      <% passed = test_cases.count { |tc| tc.passed? } %>
      <% failed = test_cases.count { |tc| tc.failed? } %>
      <% not_executed = test_cases.size - passed - failed %>
      <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700">
        <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
          <span class="inline-flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <%= passed %> passed
          </span>
          <span class="inline-flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            <%= failed %> failed
          </span>
          <span class="inline-flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600"></span>
            <%= not_executed %> other
          </span>
        </div>
        <% if test_cases.size > 0 %>
          <div class="mt-2 flex h-1.5 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-700">
            <% pass_pct = (passed.to_f / test_cases.size * 100).round(1) %>
            <% fail_pct = (failed.to_f / test_cases.size * 100).round(1) %>
            <% if passed > 0 %>
              <div class="bg-emerald-500" style="width: <%= pass_pct %>%"></div>
            <% end %>
            <% if failed > 0 %>
              <div class="bg-red-500" style="width: <%= fail_pct %>%"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rf-empty-state py-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-300 dark:text-slate-600 mx-auto mb-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm2 10a1 1 0 10-2 0v3a1 1 0 102 0v-3zm2-3a1 1 0 011 1v5a1 1 0 11-2 0v-5a1 1 0 011-1zm4 2a1 1 0 10-2 0v3a1 1 0 102 0v-3z" clip-rule="evenodd" />
        </svg>
        <p class="text-sm text-slate-400 dark:text-slate-500">No test cases linked to this requirement.</p>
        <% if policy(::TestCase.new(project: project)).create? %>
          <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
            <%= link_to "Add a test case", new_project_test_case_path(project, requirement_id: requirement.id), class: "text-brand-accent hover:text-brand-accent-dark font-medium", data: { turbo_frame: "_top" } %>
            to verify this requirement.
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
