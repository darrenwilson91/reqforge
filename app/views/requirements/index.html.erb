<% content_for(:page_title, "#{@project.name} — Requirements") %>

<div class="space-y-4">
  <%= breadcrumbs(["Projects", projects_path], [@project.name, project_path(@project)], "Requirements") %>

  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Requirements</h1>
      <p class="mt-1 text-sm text-slate-500"><%= @project.name %> &middot; <%= @requirements.size %> <%= "requirement".pluralize(@requirements.size) %></p>
    </div>
    <% if policy(Requirement).create? %>
      <%= link_to new_project_requirement_path(@project), class: "rf-btn-primary", data: { keyboard_shortcut: "new-requirement" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        New Requirement
      <% end %>
    <% end %>
  </div>

  <%# Mobile tree toggle %>
  <div class="lg:hidden">
    <button type="button" onclick="document.getElementById('req-tree-panel').classList.toggle('hidden')" class="rf-btn-secondary text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
        <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
      </svg>
      Toggle Module Tree
    </button>
  </div>

  <%# Two-panel layout: tree + content %>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <%# Left panel — hierarchy tree (hidden on mobile by default) %>
    <div id="req-tree-panel" class="hidden lg:block w-full lg:w-72 shrink-0 rf-card overflow-hidden lg:sticky lg:top-4">
      <%= render partial: "requirements/tree" %>
    </div>

    <%# Right panel — requirements list with filters %>
    <div class="flex-1 min-w-0 space-y-4">
      <%# Filters %>
      <div class="rf-card-padded">
        <%= form_tag project_requirements_path(@project), method: :get, class: "flex flex-wrap items-end gap-3 sm:gap-4" do %>
          <div class="w-full sm:flex-1 sm:min-w-[200px]">
            <label class="rf-label">Search</label>
            <%= text_field_tag :q, params[:q], placeholder: "Search by UID, title, or body...", class: "rf-input" %>
          </div>
          <div class="w-40">
            <label class="rf-label">Status</label>
            <%= select_tag :status, options_for_select([["All statuses", ""]] + Requirement.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), class: "rf-input" %>
          </div>
          <div class="w-40">
            <label class="rf-label">Type</label>
            <%= select_tag :requirement_type, options_for_select([["All types", ""]] + Requirement.requirement_types.keys.map { |t| [t.humanize, t] }, params[:requirement_type]), class: "rf-input" %>
          </div>
          <div class="flex items-end gap-2">
            <%= submit_tag "Filter", class: "rf-btn-secondary cursor-pointer" %>
            <% if params[:q].present? || params[:status].present? || params[:requirement_type].present? || params[:module_id].present? %>
              <%= link_to "Clear", project_requirements_path(@project), class: "rf-btn-secondary" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Requirements Table %>
      <% if @requirements.any? %>
        <div class="rf-card overflow-hidden">
          <table class="w-full">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50/50">
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">UID</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider hidden md:table-cell">Module / Section</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider hidden sm:table-cell">Type</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider hidden lg:table-cell">Priority</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider hidden lg:table-cell">ASIL</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @requirements.each do |req| %>
                <tr class="hover:bg-slate-50/50 transition-colors group">
                  <td class="px-4 py-3">
                    <%= link_to project_requirement_path(@project, req), class: "rf-uid text-xs" do %>
                      <%= req.uid %>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <%= link_to req.title, project_requirement_path(@project, req), class: "text-sm font-medium text-slate-900 hover:text-brand-accent-dark transition-colors" %>
                    <% if req.body.present? %>
                      <p class="mt-0.5 text-xs text-slate-400 truncate max-w-md"><%= truncate(req.body, length: 80) %></p>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 hidden md:table-cell">
                    <div class="text-xs text-slate-500">
                      <% if req.section&.requirement_module %>
                        <span class="font-medium"><%= req.section.requirement_module.name %></span>
                        <span class="text-slate-300 mx-1">/</span>
                      <% end %>
                      <span><%= req.section&.name %></span>
                    </div>
                  </td>
                  <td class="px-4 py-3 hidden sm:table-cell">
                    <span class="<%= requirement_type_badge_class(req) %>"><%= req.requirement_type.humanize %></span>
                  </td>
                  <td class="px-4 py-3">
                    <span class="<%= requirement_status_badge_class(req) %>"><%= req.status.humanize %></span>
                  </td>
                  <td class="px-4 py-3 hidden lg:table-cell">
                    <span class="<%= requirement_priority_badge_class(req) %>"><%= req.priority.humanize %></span>
                  </td>
                  <td class="px-4 py-3 hidden lg:table-cell">
                    <span class="<%= asil_badge_class(req) %>"><%= req.asil_level.upcase.sub("_", " ") %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="rf-card">
          <div class="rf-empty-state py-16">
            <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
            </svg>
            <p class="rf-empty-state-title">No requirements yet</p>
            <p class="rf-empty-state-description">
              <% if params[:q].present? || params[:status].present? || params[:requirement_type].present? || params[:module_id].present? %>
                No requirements match your filters. Try adjusting your search criteria.
              <% else %>
                Start building your requirements specification by creating the first requirement.
              <% end %>
            </p>
            <% if policy(Requirement).create? && params[:q].blank? && params[:status].blank? %>
              <%= link_to new_project_requirement_path(@project), class: "rf-btn-primary mt-4" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                New Requirement
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
