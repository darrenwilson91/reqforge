<%# Banner shown when an active change set is in session — requirement edits are recorded there instead of being applied directly %>
<% if active_change_set %>
  <div class="rounded-lg border border-amber-300 bg-amber-50 dark:bg-amber-950/30 dark:border-amber-700 px-4 py-3">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
        </svg>
        <div class="min-w-0">
          <span class="text-sm font-medium text-amber-800 dark:text-amber-300">Editing in Change Set:</span>
          <%= link_to active_change_set.title,
            project_change_set_path(active_change_set.project, active_change_set),
            class: "text-sm font-semibold text-amber-900 dark:text-amber-200 hover:underline ml-1 truncate" %>
          <span class="<%= change_set_status_badge_class(active_change_set) %> text-xs ml-2"><%= active_change_set.status.humanize %></span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <%= link_to project_change_set_path(active_change_set.project, active_change_set),
          class: "text-xs font-medium text-amber-700 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-200 transition-colors" do %>
          View Change Set
        <% end %>
        <%= link_to deactivate_project_change_set_path(active_change_set.project, active_change_set),
          data: { turbo_method: :delete },
          class: "inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
          Exit
        <% end %>
      </div>
    </div>
    <p class="mt-1 text-xs text-amber-600 dark:text-amber-500">Requirement edits will be recorded as proposed changes — not applied until the change set is merged.</p>
  </div>
<% end %>
