<% content_for(:page_title, "Dashboard") %>

<div class="space-y-6">
  <%# Welcome Banner %>
  <div class="rf-card-padded">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Welcome back<%= ", #{current_user.first_name}" if current_user %></h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          <% if @is_manager %>
            Organization overview and team performance.
          <% else %>
            Your requirements, reviews, and assignments.
          <% end %>
        </p>
      </div>
      <% if current_membership %>
        <span class="rf-badge bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300 text-xs"><%= current_membership.role.humanize %></span>
      <% end %>
    </div>
  </div>

  <% if @projects_count && @projects_count > 0 %>
    <%# Stats Grid %>
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rf-card p-5">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= @projects_count %></div>
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Projects</div>
          </div>
        </div>
      </div>

      <div class="rf-card p-5">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= @requirements_count %></div>
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Requirements</div>
          </div>
        </div>
      </div>

      <div class="rf-card p-5">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
              <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= @active_reviews_count %></div>
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Active Reviews</div>
          </div>
        </div>
      </div>

      <div class="rf-card p-5">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-900/30 dark:text-violet-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= @team_members_count %></div>
            <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Team Members</div>
          </div>
        </div>
      </div>
    </div>

    <% if @is_manager %>
      <%# ===== MANAGER VIEW ===== %>

      <%# Org-wide Metrics Row %>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="rf-card p-4">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Approval Rate</div>
          <div class="mt-1 text-xl font-bold text-slate-900 dark:text-slate-100"><%= @approval_rate %>%</div>
          <div class="mt-2 h-1.5 rounded-full bg-slate-100 dark:bg-slate-700">
            <div class="h-1.5 rounded-full <%= @approval_rate >= 70 ? 'bg-emerald-500' : @approval_rate >= 40 ? 'bg-amber-500' : 'bg-red-500' %>" style="width: <%= @approval_rate %>%"></div>
          </div>
        </div>
        <div class="rf-card p-4">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Reviews Completed</div>
          <div class="mt-1 text-xl font-bold text-slate-900 dark:text-slate-100"><%= @reviews_completed %><span class="text-sm font-normal text-slate-400"> / <%= @reviews_total %></span></div>
        </div>
        <div class="rf-card p-4">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Open Change Sets</div>
          <div class="mt-1 text-xl font-bold text-slate-900 dark:text-slate-100"><%= @open_change_sets %></div>
        </div>
        <div class="rf-card p-4">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Merged Change Sets</div>
          <div class="mt-1 text-xl font-bold text-slate-900 dark:text-slate-100"><%= @merged_change_sets %></div>
        </div>
        <div class="rf-card p-4">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Test Cases</div>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= @test_cases_count %></span>
            <% if @test_cases_count > 0 %>
              <span class="text-xs text-emerald-600 dark:text-emerald-400"><%= @test_cases_passed %> passed</span>
              <% if @test_cases_failed > 0 %>
                <span class="text-xs text-red-600 dark:text-red-400"><%= @test_cases_failed %> failed</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <%# Requirement Status Breakdown %>
      <% if @requirement_status_counts.any? %>
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Requirement Status Breakdown</h3>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-1 h-4 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-700">
              <% status_colors = { "draft" => "bg-slate-400", "in_review" => "bg-blue-500", "approved" => "bg-emerald-500", "implemented" => "bg-violet-500", "verified" => "bg-indigo-500", "obsolete" => "bg-red-400" } %>
              <% total = @requirement_status_counts.values.sum %>
              <% @requirement_status_counts.each do |status, count| %>
                <% pct = total > 0 ? (count.to_f / total * 100) : 0 %>
                <% next if pct < 1 %>
                <div class="h-full <%= status_colors[status] || 'bg-slate-300' %>" style="width: <%= pct %>%" title="<%= status.humanize %>: <%= count %>"></div>
              <% end %>
            </div>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
              <% %w[draft in_review approved implemented verified obsolete].each do |status| %>
                <% count = @requirement_status_counts[status] || @requirement_status_counts[Requirement.statuses[status]] || 0 %>
                <% next if count == 0 %>
                <div class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-400">
                  <div class="w-2.5 h-2.5 rounded-full <%= status_colors[status] %>"></div>
                  <span><%= status.humanize %></span>
                  <span class="font-semibold text-slate-900 dark:text-slate-100"><%= count %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <%# Overdue Change Sets %>
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Review Bottlenecks</h3>
              <span class="text-xs text-slate-400 dark:text-slate-500">Waiting &gt; 3 days</span>
            </div>
          </div>
          <% if @overdue_change_sets.any? %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% @overdue_change_sets.each do |cs| %>
                <%= link_to project_change_set_path(cs.project, cs), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                  <div class="flex items-center justify-center w-8 h-8 rounded-full bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= cs.title %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= cs.project.prefix %> &middot; by <%= cs.created_by.first_name %></p>
                  </div>
                  <span class="text-xs text-amber-600 dark:text-amber-400 font-medium shrink-0"><%= time_ago_in_words(cs.created_at) %></span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="rf-empty-state py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <p class="rf-empty-state-description">No overdue reviews</p>
            </div>
          <% end %>
        </div>

        <%# Reviewers with Outstanding Approvals %>
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Outstanding Approvals by Reviewer</h3>
          </div>
          <% if @pending_approvals.any? %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% @pending_approvals.each do |user, count| %>
                <div class="flex items-center gap-3 px-5 py-3">
                  <div class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-50 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300 text-xs font-semibold shrink-0">
                    <%= user.first_name[0] %><%= user.last_name[0] %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100"><%= user.full_name %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= user.email %></p>
                  </div>
                  <span class="rf-badge bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"><%= count %> pending</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="rf-empty-state py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <p class="rf-empty-state-description">No outstanding approvals</p>
            </div>
          <% end %>
        </div>
      </div>

      <%# Recent Activity %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Recent Projects</h3>
              <%= link_to "View all", projects_path, class: "text-xs font-medium text-brand-accent hover:text-brand-accent-dark transition-colors" %>
            </div>
          </div>
          <div class="divide-y divide-slate-100 dark:divide-slate-700">
            <% @recent_projects.each do |project| %>
              <%= link_to project_path(project), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                <span class="rf-badge bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 text-xs"><%= project.prefix %></span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= project.name %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400"><%= project.requirements.count %> requirements</p>
                </div>
                <span class="text-xs text-slate-400"><%= time_ago_in_words(project.updated_at) %> ago</span>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Recent Requirements</h3>
          </div>
          <% if @recent_requirements.any? %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% @recent_requirements.each do |req| %>
                <%= link_to project_requirement_path(req.project, req), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                  <span class="rf-uid"><%= req.uid %></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= req.title %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= req.project.prefix %></p>
                  </div>
                  <span class="text-xs text-slate-400"><%= time_ago_in_words(req.updated_at) %> ago</span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="rf-empty-state py-10">
              <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
              </svg>
              <p class="rf-empty-state-title">No requirements yet</p>
              <p class="rf-empty-state-description">Add requirements to your projects to see them here.</p>
            </div>
          <% end %>
        </div>
      </div>

    <% else %>
      <%# ===== ENGINEER VIEW ===== %>

      <%# My Pending Reviews %>
      <div class="rf-card">
        <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Pending Reviews</h3>
              <% if @my_pending_reviews.any? %>
                <span class="rf-badge bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 text-xs"><%= @my_pending_reviews.size %></span>
              <% end %>
            </div>
          </div>
        </div>
        <% if @my_pending_reviews.any? %>
          <div class="divide-y divide-slate-100 dark:divide-slate-700">
            <% @my_pending_reviews.each do |approval| %>
              <% cs = approval.change_set %>
              <%= link_to project_change_set_path(cs.project, cs), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                <div class="flex items-center justify-center w-8 h-8 rounded-full bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= cs.title %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400"><%= cs.project.prefix %> &middot; by <%= cs.created_by.first_name %> &middot; <%= time_ago_in_words(cs.created_at) %> ago</p>
                </div>
                <span class="rf-badge bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 text-xs">Needs your review</span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="rf-empty-state py-8">
            <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <p class="rf-empty-state-description">No pending reviews</p>
          </div>
        <% end %>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <%# My Requirements %>
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">My Requirements</h3>
                <span class="text-xs text-slate-400 dark:text-slate-500"><%= @my_requirements_count %> total</span>
              </div>
            </div>
          </div>
          <% if @my_requirements.any? %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% @my_requirements.each do |req| %>
                <%= link_to project_requirement_path(req.project, req), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                  <span class="rf-uid"><%= req.uid %></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= req.title %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= req.project.prefix %></p>
                  </div>
                  <span class="<%= helpers.requirement_status_badge_class(req) %> text-xs"><%= req.status.humanize %></span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="rf-empty-state py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
              </svg>
              <p class="rf-empty-state-description">No requirements authored by you yet</p>
            </div>
          <% end %>
        </div>

        <%# My Change Sets %>
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">My Active Change Sets</h3>
          </div>
          <% if @my_change_sets.any? %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% @my_change_sets.each do |cs| %>
                <%= link_to project_change_set_path(cs.project, cs), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                  <span class="<%= helpers.change_set_status_badge_class(cs) %> text-xs"><%= cs.status.humanize %></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= cs.title %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= cs.project.prefix %></p>
                  </div>
                  <span class="text-xs text-slate-400"><%= time_ago_in_words(cs.updated_at) %> ago</span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="rf-empty-state py-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <p class="rf-empty-state-description">No active change sets</p>
            </div>
          <% end %>
        </div>
      </div>

      <%# My Test Cases %>
      <% if @my_test_cases.any? %>
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">My Test Cases Needing Attention</h3>
          </div>
          <div class="divide-y divide-slate-100 dark:divide-slate-700">
            <% @my_test_cases.each do |tc| %>
              <%= link_to project_test_case_path(tc.project, tc), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                <span class="rf-uid"><%= tc.uid %></span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= tc.title %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400"><%= tc.project.prefix %></p>
                </div>
                <span class="<%= helpers.test_status_badge_class(tc) %> text-xs"><%= tc.status.humanize %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Recent Activity (same as before but for engineers) %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Recent Projects</h3>
              <%= link_to "View all", projects_path, class: "text-xs font-medium text-brand-accent hover:text-brand-accent-dark transition-colors" %>
            </div>
          </div>
          <div class="divide-y divide-slate-100 dark:divide-slate-700">
            <% @recent_projects.each do |project| %>
              <%= link_to project_path(project), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                <span class="rf-badge bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 text-xs"><%= project.prefix %></span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= project.name %></p>
                  <p class="text-xs text-slate-500 dark:text-slate-400"><%= project.requirements.count %> requirements</p>
                </div>
                <span class="text-xs text-slate-400"><%= time_ago_in_words(project.updated_at) %> ago</span>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="rf-card">
          <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Recent Requirements</h3>
          </div>
          <% if @recent_requirements.any? %>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              <% @recent_requirements.each do |req| %>
                <%= link_to project_requirement_path(req.project, req), class: "flex items-center gap-3 px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors" do %>
                  <span class="rf-uid"><%= req.uid %></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate"><%= req.title %></p>
                    <p class="text-xs text-slate-500 dark:text-slate-400"><%= req.project.prefix %></p>
                  </div>
                  <span class="text-xs text-slate-400"><%= time_ago_in_words(req.updated_at) %> ago</span>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="rf-empty-state py-10">
              <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
              </svg>
              <p class="rf-empty-state-title">No requirements yet</p>
              <p class="rf-empty-state-description">Add requirements to your projects to see them here.</p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Quick Actions %>
    <div class="rf-card-padded">
      <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Quick Actions</h3>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= link_to new_project_path, class: "rf-btn-primary" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          New Project
        <% end %>
      </div>
    </div>

  <% else %>
    <%# Getting Started Empty State %>
    <div class="rf-card">
      <div class="rf-empty-state py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon w-16 h-16" viewBox="0 0 20 20" fill="currentColor">
          <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
        </svg>
        <p class="rf-empty-state-title text-base">Get started with ReqForge</p>
        <p class="rf-empty-state-description mt-2">Create your first project to start managing requirements, building traceability, and running reviews.</p>
        <div class="mt-6">
          <%= link_to new_project_path, class: "rf-btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Create First Project
          <% end %>
        </div>
      </div>
    </div>

    <%# Getting Started Steps %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rf-card-padded">
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 text-sm font-bold shrink-0">1</div>
          <div>
            <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Create a project</h4>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Choose a compliance template (ISO 26262, ASPICE) or start blank with custom attributes.</p>
          </div>
        </div>
      </div>
      <div class="rf-card-padded">
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400 text-sm font-bold shrink-0">2</div>
          <div>
            <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Add requirements</h4>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Write requirements in modules and sections, or import from CSV/ReqIF.</p>
          </div>
        </div>
      </div>
      <div class="rf-card-padded">
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400 text-sm font-bold shrink-0">3</div>
          <div>
            <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Build traceability</h4>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Link requirements across phases, run AI analysis, and start reviews.</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
