<%# Skeleton loading state for table layouts (requirements, traceability)
    Usage: render "shared/skeleton_table", rows: 8, cols: 5 %>
<% rows ||= 8 %>
<% cols ||= 5 %>
<div class="rf-card overflow-hidden">
  <table class="w-full">
    <thead>
      <tr class="border-b border-slate-200 bg-slate-50">
        <% cols.times do %>
          <th class="px-4 py-3 text-left">
            <div class="rf-skeleton-line-sm w-20"></div>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.times do |i| %>
        <tr class="border-b border-slate-100 last:border-0">
          <% cols.times do |j| %>
            <td class="px-4 py-3">
              <% if j == 0 %>
                <div class="rf-skeleton-line-sm w-16"></div>
              <% elsif j == 1 %>
                <div class="rf-skeleton-line w-3/4"></div>
              <% else %>
                <div class="rf-skeleton-badge"></div>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
