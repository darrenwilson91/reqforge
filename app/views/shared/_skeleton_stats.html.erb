<%# Skeleton loading state for stat card rows (dashboard, compliance)
    Usage: render "shared/skeleton_stats", count: 4 %>
<% count ||= 4 %>
<div class="grid grid-cols-2 lg:grid-cols-<%= count %> gap-4">
  <% count.times do %>
    <div class="rf-card p-4">
      <div class="rf-skeleton-line-sm w-20 mb-2"></div>
      <div class="rf-skeleton-line-lg w-12"></div>
    </div>
  <% end %>
</div>
