<nav class="flex flex-col w-64 min-h-screen bg-brand-navy-dark text-slate-300 shrink-0">
  <!-- Brand -->
  <div class="flex items-center justify-between h-16 px-5 border-b border-white/10">
    <div class="flex items-center gap-2.5">
      <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-brand-accent text-brand-navy-dark">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
        </svg>
      </div>
      <span class="text-lg font-semibold tracking-tight text-white">ReqForge</span>
    </div>
    <button type="button"
            data-action="sidebar#close"
            class="lg:hidden p-1 rounded-md text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
            aria-label="Close sidebar">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <!-- Organization Selector -->
  <% if current_organization %>
    <div class="px-4 py-3 border-b border-white/10">
      <div class="text-xs font-medium tracking-wider uppercase text-slate-500">Organization</div>
      <div class="mt-1 text-sm font-medium text-slate-200 truncate"><%= current_organization.name %></div>
    </div>
  <% end %>

  <!-- Navigation -->
  <div class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <div class="mb-3 rf-section-label px-2">Main</div>

    <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{current_page?(root_path) ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
      </svg>
      Dashboard
    <% end %>

    <div class="mt-6 mb-3 rf-section-label px-2">Requirements</div>

    <%= link_to projects_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{current_page?(projects_path) ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
      </svg>
      Projects
    <% end %>

    <% traceability_path = @project&.persisted? ? project_traceability_matrix_path(@project) : projects_path %>
    <% traceability_active = @project&.persisted? && controller_name.in?(%w[traceability_matrices traceability_graphs]) %>
    <%= link_to traceability_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{traceability_active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2zm1 5a1 1 0 00-1 1v2a1 1 0 001 1h12a1 1 0 001-1v-2a1 1 0 00-1-1H4z" clip-rule="evenodd" />
      </svg>
      Traceability
    <% end %>

    <% compliance_path = @project&.persisted? ? project_compliance_dashboard_path(@project) : projects_path %>
    <% compliance_active = @project&.persisted? && controller_name == "compliance_dashboards" %>
    <%= link_to compliance_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{compliance_active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
      </svg>
      Compliance
    <% end %>

    <% import_export_path = @project&.persisted? ? project_import_export_path(@project) : projects_path %>
    <% import_export_active = controller_name == "import_exports" %>
    <%= link_to import_export_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{import_export_active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M13 7H7v6h6V7z" />
        <path fill-rule="evenodd" d="M7 2a1 1 0 012 0v1h2V2a1 1 0 112 0v1h2a2 2 0 012 2v2h1a1 1 0 110 2h-1v2h1a1 1 0 110 2h-1v2a2 2 0 01-2 2h-2v1a1 1 0 11-2 0v-1H9v1a1 1 0 11-2 0v-1H5a2 2 0 01-2-2v-2H2a1 1 0 110-2h1V9H2a1 1 0 010-2h1V5a2 2 0 012-2h2V2zM5 5h10v10H5V5z" clip-rule="evenodd" />
      </svg>
      Import / Export
    <% end %>

    <div class="mt-6 mb-3 rf-section-label px-2">Collaboration</div>

    <% change_sets_path_target = @project&.persisted? ? project_change_sets_path(@project) : projects_path %>
    <% change_sets_active = controller_name.in?(%w[change_sets change_set_comments]) %>
    <%= link_to change_sets_path_target, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{change_sets_active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
      </svg>
      <span class="flex flex-col">
        <span>Change Sets</span>
        <span class="text-[10px] font-normal text-slate-500">Propose &amp; review changes</span>
      </span>
    <% end %>

    <% reviews_path_target = @project&.persisted? ? project_reviews_path(@project) : projects_path %>
    <% reviews_active = controller_name.in?(%w[reviews review_items review_comments]) %>
    <%= link_to reviews_path_target, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{reviews_active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
        <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
      </svg>
      <span class="flex flex-col">
        <span>Reviews</span>
        <span class="text-[10px] font-normal text-slate-500">Formal compliance reviews</span>
      </span>
    <% end %>

    <% settings_path_target = @project&.persisted? ? project_change_set_rules_path(@project) : projects_path %>
    <% settings_active = controller_name == "change_set_rules" %>
    <%= link_to settings_path_target, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors #{settings_active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/60 hover:text-slate-200'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
      </svg>
      Settings
    <% end %>

    <div class="mt-6 mb-3 rf-section-label px-2">AI Tools</div>

    <span class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-600 cursor-default" title="AI quality analysis is available on individual requirement detail pages">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z" />
      </svg>
      Quality Analysis
      <span class="ml-auto text-[10px] text-slate-700 bg-slate-800 px-1.5 py-0.5 rounded">Per Req</span>
    </span>
  </div>

  <!-- Keyboard Shortcuts Hint -->
  <div class="px-4 py-2 border-t border-white/10">
    <button type="button" data-action="keyboard-shortcuts#toggleOverlay" class="flex items-center gap-2 w-full px-2 py-1.5 rounded-md text-xs text-slate-500 hover:text-slate-300 hover:bg-slate-800/60 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
      </svg>
      Keyboard shortcuts
      <kbd class="ml-auto text-[10px] font-mono text-slate-600 border border-slate-700 rounded px-1">?</kbd>
    </button>
  </div>

  <!-- User Info (bottom) -->
  <% if current_user %>
    <div class="px-4 py-3 border-t border-white/10">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-slate-700 text-slate-300 text-sm font-medium">
          <%= current_user.first_name[0] %><%= current_user.last_name[0] %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-sm font-medium text-slate-200 truncate"><%= current_user.full_name %></div>
          <div class="text-xs text-slate-500 truncate"><%= current_user.email %></div>
        </div>
      </div>
    </div>
  <% end %>
</nav>
