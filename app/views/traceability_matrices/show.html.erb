<% content_for(:page_title, "#{@project.name} — Traceability Matrix") %>

<div class="space-y-6">
  <%# Breadcrumb %>
  <nav class="flex items-center gap-2 text-sm text-slate-500">
    <%= link_to "Projects", projects_path, class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <%= link_to @project.name, project_path(@project), class: "hover:text-brand-accent-dark transition-colors" %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
    <span class="text-slate-900 font-medium">Traceability Matrix</span>
  </nav>

  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Traceability Matrix</h1>
      <p class="mt-1 text-sm text-slate-500"><%= @project.name %> &middot; <%= @all_requirements.size %> <%= "requirement".pluralize(@all_requirements.size) %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to project_traceability_graph_path(@project), class: "rf-btn-secondary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        Graph View
      <% end %>
      <%= link_to project_requirements_path(@project), class: "rf-btn-secondary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
        </svg>
        Requirements
      <% end %>
    </div>
  </div>

  <%# Coverage Summary %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total</div>
      <div class="mt-1 text-2xl font-bold text-slate-900"><%= @coverage[:total_requirements] %></div>
    </div>
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Linked</div>
      <div class="mt-1 text-2xl font-bold text-emerald-600"><%= @coverage[:linked_requirements] %></div>
    </div>
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Unlinked</div>
      <div class="mt-1 text-2xl font-bold <%= @coverage[:unlinked_requirements] > 0 ? 'text-amber-600' : 'text-slate-400' %>"><%= @coverage[:unlinked_requirements] %></div>
    </div>
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Coverage</div>
      <div class="mt-1 flex items-baseline gap-2">
        <span class="text-2xl font-bold <%= @coverage[:coverage_percentage] >= 80 ? 'text-emerald-600' : @coverage[:coverage_percentage] >= 50 ? 'text-amber-600' : 'text-red-600' %>"><%= @coverage[:coverage_percentage] %>%</span>
      </div>
      <div class="mt-2 w-full bg-slate-100 rounded-full h-1.5">
        <div class="h-1.5 rounded-full transition-all duration-300 <%= @coverage[:coverage_percentage] >= 80 ? 'bg-emerald-500' : @coverage[:coverage_percentage] >= 50 ? 'bg-amber-500' : 'bg-red-500' %>" style="width: <%= @coverage[:coverage_percentage] %>%"></div>
      </div>
    </div>
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-blue-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        Forward
      </div>
      <div class="mt-1 text-2xl font-bold text-blue-600"><%= @coverage[:forward_coverage] %>%</div>
      <div class="text-xs text-slate-400 mt-0.5"><%= @coverage[:forward_count] %> req with outgoing</div>
    </div>
    <div class="rf-card p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-500" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Backward
      </div>
      <div class="mt-1 text-2xl font-bold text-green-600"><%= @coverage[:backward_coverage] %>%</div>
      <div class="text-xs text-slate-400 mt-0.5"><%= @coverage[:backward_count] %> req with incoming</div>
    </div>
  </div>

  <%# Per-Link-Type Coverage %>
  <% if @coverage[:by_link_type].any? %>
    <div class="rf-card overflow-hidden">
      <div class="px-5 py-3 border-b border-slate-200">
        <h3 class="text-sm font-semibold text-slate-900">Coverage by Link Type</h3>
      </div>
      <table class="w-full">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50/50">
            <th class="px-5 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Link Type</th>
            <th class="px-5 py-2 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Links</th>
            <th class="px-5 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-blue-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
                Forward (Outgoing)
              </span>
            </th>
            <th class="px-5 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <span class="inline-flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Backward (Incoming)
              </span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @coverage[:by_link_type].each do |type, stats| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-5 py-2.5">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full <%= link_type_dot_class(type) %>"></span>
                  <span class="text-sm font-medium text-slate-700"><%= type.to_s.humanize %></span>
                </div>
              </td>
              <td class="px-5 py-2.5 text-right">
                <span class="text-sm font-semibold text-slate-900"><%= stats[:count] %></span>
              </td>
              <td class="px-5 py-2.5">
                <div class="flex items-center gap-3">
                  <div class="flex-1 max-w-[120px] bg-slate-100 rounded-full h-1.5">
                    <div class="h-1.5 rounded-full bg-blue-500 transition-all duration-300" style="width: <%= stats[:forward_percentage] %>%"></div>
                  </div>
                  <span class="text-xs font-medium text-slate-600 w-16 text-right"><%= stats[:forward_percentage] %>%</span>
                  <span class="text-xs text-slate-400">(<%= stats[:forward_count] %> req)</span>
                </div>
              </td>
              <td class="px-5 py-2.5">
                <div class="flex items-center gap-3">
                  <div class="flex-1 max-w-[120px] bg-slate-100 rounded-full h-1.5">
                    <div class="h-1.5 rounded-full bg-green-500 transition-all duration-300" style="width: <%= stats[:backward_percentage] %>%"></div>
                  </div>
                  <span class="text-xs font-medium text-slate-600 w-16 text-right"><%= stats[:backward_percentage] %>%</span>
                  <span class="text-xs text-slate-400">(<%= stats[:backward_count] %> req)</span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%# Filters %>
  <div class="rf-card-padded">
    <%= form_tag project_traceability_matrix_path(@project), method: :get, class: "flex flex-wrap items-end gap-4" do %>
      <div class="w-48">
        <label class="rf-label">Source Module</label>
        <%= select_tag :source_module, options_for_select(
          [["All modules", ""]] + @modules.map { |m| [m.name, m.id] },
          params[:source_module]
        ), class: "rf-input" %>
      </div>
      <div class="w-48">
        <label class="rf-label">Target Module</label>
        <%= select_tag :target_module, options_for_select(
          [["All modules", ""]] + @modules.map { |m| [m.name, m.id] },
          params[:target_module]
        ), class: "rf-input" %>
      </div>
      <div class="flex-1 min-w-[200px]">
        <label class="rf-label">Link Types</label>
        <div class="flex flex-wrap gap-2 mt-1">
          <% TraceabilityLink.link_types.keys.each do |lt| %>
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <%= check_box_tag "link_types[]", lt,
                params[:link_types]&.include?(lt),
                class: "rounded border-slate-300 text-brand-accent focus:ring-brand-accent" %>
              <span class="text-sm text-slate-600"><%= lt.humanize %></span>
            </label>
          <% end %>
        </div>
      </div>
      <div class="flex items-end gap-2">
        <%= submit_tag "Filter", class: "rf-btn-secondary cursor-pointer" %>
        <% if params[:source_module].present? || params[:target_module].present? || params[:link_types].present? %>
          <%= link_to "Clear", project_traceability_matrix_path(@project), class: "rf-btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Matrix Grid %>
  <% rows = @matrix[:rows].to_a %>
  <% columns = @matrix[:columns].to_a %>
  <% cells = @matrix[:cells] %>

  <% if rows.any? && columns.any? %>
    <div class="rf-card overflow-hidden relative" data-controller="matrix">
      <%# Tooltip %>
      <div data-matrix-target="tooltip"
           class="hidden absolute z-20 bg-white border border-slate-200 rounded-lg shadow-lg px-3 py-2 pointer-events-none">
      </div>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <%# Corner cell %>
              <th class="sticky left-0 z-10 bg-white px-3 py-2 text-left border-b border-r border-slate-200">
                <div class="text-xs font-medium text-slate-400">
                  <span class="block">Source &darr;</span>
                  <span class="block">Target &rarr;</span>
                </div>
              </th>
              <%# Column headers (target requirements) %>
              <% columns.each do |col| %>
                <th class="px-1 py-2 border-b border-slate-200 min-w-[52px]"
                    data-matrix-target="colHeader"
                    data-matrix-col="<%= col.id %>"
                    data-action="mouseenter->matrix#highlightCol mouseleave->matrix#unhighlightCol">
                  <%= link_to project_requirement_path(col.project, col),
                      class: "block text-center group transition-colors",
                      title: "#{col.uid}: #{col.title}" do %>
                    <span class="rf-uid text-[10px] block leading-tight group-hover:text-brand-accent-dark"><%= col.uid %></span>
                  <% end %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr class="group/row">
                <%# Row header (source requirement) %>
                <td class="sticky left-0 z-10 bg-white px-3 py-1.5 border-b border-r border-slate-200 whitespace-nowrap"
                    data-matrix-target="rowHeader"
                    data-matrix-row="<%= row.id %>"
                    data-action="mouseenter->matrix#highlightRow mouseleave->matrix#unhighlightRow">
                  <%= link_to project_requirement_path(row.project, row),
                      class: "flex items-center gap-2 group transition-colors",
                      title: "#{row.uid}: #{row.title}" do %>
                    <span class="rf-uid text-[10px]"><%= row.uid %></span>
                    <span class="text-xs text-slate-500 group-hover:text-brand-accent-dark truncate max-w-[160px]"><%= row.title %></span>
                  <% end %>
                </td>
                <%# Matrix cells %>
                <% columns.each do |col| %>
                  <% cell_key = "#{row.id}_#{col.id}" %>
                  <% link_types = cells[cell_key] %>
                  <td class="px-1 py-1.5 border-b border-slate-100 text-center"
                      data-matrix-target="cell"
                      data-matrix-row="<%= row.id %>"
                      data-matrix-col="<%= col.id %>"
                      <% if link_types.present? %>
                        data-matrix-link-types="<%= link_types.join(',') %>"
                        data-matrix-source-uid="<%= row.uid %>"
                        data-matrix-target-uid="<%= col.uid %>"
                        data-action="mouseenter->matrix#showTooltip mouseleave->matrix#hideTooltip"
                      <% end %>
                      >
                    <% if row.id == col.id %>
                      <span class="inline-block w-6 h-6 bg-slate-100 rounded"></span>
                    <% elsif link_types.present? %>
                      <div class="inline-flex flex-wrap justify-center gap-0.5 cursor-pointer">
                        <% link_types.uniq.each do |lt| %>
                          <span class="w-2.5 h-2.5 rounded-sm <%= link_type_dot_class(lt) %>" title="<%= lt.to_s.humanize %>"></span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="inline-block w-6 h-6"></span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# Legend %>
      <div class="px-4 py-3 border-t border-slate-200 bg-slate-50/50">
        <div class="flex items-center gap-4 flex-wrap">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Legend:</span>
          <% TraceabilityLink.link_types.keys.each do |lt| %>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm <%= link_type_dot_class(lt) %>"></span>
              <span class="text-xs text-slate-600"><%= lt.humanize %></span>
            </div>
          <% end %>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-2.5 h-2.5 bg-slate-100 rounded"></span>
            <span class="text-xs text-slate-600">Self (diagonal)</span>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <%# Empty state %>
    <div class="rf-card">
      <div class="rf-empty-state py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="rf-empty-state-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2zm1 5a1 1 0 00-1 1v2a1 1 0 001 1h12a1 1 0 001-1v-2a1 1 0 00-1-1H4z" clip-rule="evenodd" />
        </svg>
        <p class="rf-empty-state-title">No traceability links yet</p>
        <p class="rf-empty-state-description">
          <% if params[:source_module].present? || params[:target_module].present? || params[:link_types].present? %>
            No links match your current filters. Try adjusting your criteria.
          <% else %>
            Create traceability links between requirements to see the matrix. Links show how requirements relate across modules and phases.
          <% end %>
        </p>
        <%= link_to project_requirements_path(@project), class: "rf-btn-primary mt-4" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          Go to Requirements
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Unlinked Requirements %>
  <% if @coverage[:unlinked_requirements] > 0 %>
    <% unlinked = @all_requirements.where(id: @coverage[:unlinked_requirement_ids]) %>
    <div class="rf-card overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-200 bg-amber-50/50">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <span class="text-sm font-semibold text-amber-800">Unlinked Requirements (<%= @coverage[:unlinked_requirements] %>)</span>
        </div>
        <p class="text-xs text-amber-600 mt-1">These requirements have no traceability links and may represent coverage gaps.</p>
      </div>
      <table class="w-full">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50/50">
            <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">UID</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Title</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Module</th>
            <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% unlinked.each do |req| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-4 py-2">
                <%= link_to project_requirement_path(@project, req), class: "rf-uid text-xs" do %>
                  <%= req.uid %>
                <% end %>
              </td>
              <td class="px-4 py-2">
                <%= link_to req.title, project_requirement_path(@project, req), class: "text-sm font-medium text-slate-900 hover:text-brand-accent-dark transition-colors" %>
              </td>
              <td class="px-4 py-2 text-xs text-slate-500">
                <%= req.section&.requirement_module&.name %>
              </td>
              <td class="px-4 py-2">
                <span class="<%= requirement_status_badge_class(req) %>"><%= req.status.humanize %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
