<% content_for(:title, "Set Up Your Organization — ReqForge") %>

<div class="rf-card-padded max-w-lg mx-auto">
  <div class="text-center mb-6">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-accent/10 text-brand-accent mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
      </svg>
    </div>
    <h1 class="text-xl font-bold text-slate-900">Create Your Organization</h1>
    <p class="mt-1 text-sm text-slate-500">Organizations are workspaces where your team manages requirements, projects, and reviews together.</p>
  </div>

  <%= form_with(model: @organization, url: organizations_path, class: "space-y-5") do |f| %>
    <% if @organization.errors.any? %>
      <div class="rounded-lg bg-red-50 border border-red-200 p-4">
        <div class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="text-sm font-medium text-red-800">Please fix the following:</h3>
            <ul class="mt-1 text-sm text-red-700 list-disc list-inside">
              <% @organization.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Organization name", class: "rf-label" %>
      <%= f.text_field :name, class: "rf-input", placeholder: "e.g. Acme Engineering", autofocus: true, required: true %>
      <p class="mt-1.5 text-xs text-slate-400">This will be the name your team sees. You can change it later.</p>
    </div>

    <div>
      <%= f.submit "Create Organization", class: "rf-btn-accent w-full justify-center cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-6 pt-5 border-t border-slate-200 text-center">
    <p class="text-sm text-slate-500">
      Been invited to an existing organization? Ask your team admin to send you an invitation.
    </p>
  </div>
</div>
